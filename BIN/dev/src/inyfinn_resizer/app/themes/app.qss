/* Inyfinn Photo Resizer — płaski układ Bento (bez ramek kontenerów) */

QMainWindow {
    background-color: @BG_WINDOW@;
    color: @FG_TEXT@;
    font-family: "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
}

QWidget#centralRoot, QWidget#settingsBody, QWidget#formatSelector, QWidget#leftColumn {
    background-color: transparent;
    color: @FG_TEXT@;
}

QLabel {
    background-color: transparent;
    color: @FG_TEXT@;
}

QLabel#appTitle {
    font-size: 16px;
    font-weight: 600;
    color: @FG_TITLE@;
}

QLabel#versionBadge {
    font-size: 11px;
    font-weight: 600;
    color: @FG_ACCENT@;
    background: transparent;
}

QLabel#panelTitle {
    font-size: 13px;
    font-weight: 700;
    color: @FG_TITLE@;
    padding: 0;
    margin: 0;
    background: transparent;
}

QLabel#sectionTitle {
    font-size: 12px;
    font-weight: 700;
    color: @FG_MUTED@;
    background: transparent;
}

QLabel#fieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: @FG_TEXT@;
    background: transparent;
    padding: 0;
    margin: 0;
}

QLabel#advancedSummary {
    font-size: 11px;
    color: @FG_MUTED@;
    padding: 0;
    background: transparent;
    border: none;
}

QLabel#appFooter {
    font-size: 11px;
    font-weight: 600;
    color: @FG_MUTED@;
    padding: 0 4px;
    background: transparent;
}

QDialog#helpGuideDialog {
    background-color: @BG_WINDOW@;
    color: @FG_TEXT@;
}

QLabel#helpGuideIntro {
    font-size: 13px;
    color: @FG_TEXT@;
    background: transparent;
}

QLabel#helpGuideItem {
    font-size: 13px;
    line-height: 1.45;
    color: @FG_TEXT@;
    padding: 2px 0;
    background: transparent;
}

QWidget#helpGuideBody {
    background: transparent;
}

QFrame#helpGuideSection {
    background-color: @BG_PANEL@;
    border: none;
    border-radius: 16px;
}

QLabel#helpGuideBullet {
    font-size: 13px;
    color: @FG_ACCENT@;
    background: transparent;
}

QScrollArea#helpGuideScroll {
    background: transparent;
    border: none;
}

QLabel#helpGuideTitle {
    font-size: 15px;
    font-weight: 700;
    color: @FG_TITLE@;
}

QLabel#helpGuideVersion {
    font-size: 11px;
    font-weight: 600;
    color: @FG_ACCENT@;
}

QLabel#helpGuideContent {
    font-size: 13px;
    color: @FG_TEXT@;
    padding: 4px 2px;
}

QWidget#fieldGroup {
    background: transparent;
}

QLabel#formLabel, QLabel#formLabelInline {
    color: @FG_MUTED@;
    font-weight: 600;
    background: transparent;
}

QLabel#hintLabel, QLabel#dropHint {
    color: @FG_MUTED@;
    font-size: 12px;
}

QLabel#queueCount {
    font-size: 14px;
    font-weight: 700;
    color: @FG_ACCENT@;
}

QLabel#qualityValue {
    font-weight: 700;
    color: @FG_ACCENT@;
}

QLabel#previewMeta {
    color: @FG_MUTED@;
    font-size: 12px;
}

/* —— Kafelki Bento —— */
QFrame#bentoTile {
    background-color: @BG_PANEL@;
    border: none;
    border-radius: 16px;
}

QFrame#panel, QFrame#dropPanel, QFrame#sectionBox, QFrame#previewPanel {
    background-color: @BG_PANEL@;
    border: none;
    border-radius: 16px;
}

QLabel#sectionStepTitle {
    font-size: 13px;
    font-weight: 700;
    color: @FG_TITLE@;
    background: transparent;
    padding: 0;
}

QLabel#sectionStepHint {
    font-size: 11px;
    color: @FG_MUTED@;
    background: transparent;
    padding: 0;
    line-height: 1.35;
}

QLabel#workflowHint {
    font-size: 11px;
    color: @FG_MUTED@;
    background: transparent;
    padding: 0 2px 4px 2px;
}

QSlider {
    min-height: 20px;
    padding: 2px 0;
}

QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

QScrollArea#settingsScroll > QWidget > QWidget {
    background: transparent;
}

QScrollArea#settingsScroll QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 0 4px 2px;
    border: none;
}

QScrollArea#settingsScroll QScrollBar::handle:vertical {
    background: @BORDER@;
    border-radius: 5px;
    min-height: 40px;
}

QScrollArea#settingsScroll QScrollBar::handle:vertical:hover {
    background: @FG_MUTED@;
}

QScrollArea#settingsScroll QScrollBar::add-line:vertical,
QScrollArea#settingsScroll QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QScrollArea#settingsScroll QScrollBar::add-page:vertical,
QScrollArea#settingsScroll QScrollBar::sub-page:vertical {
    background: none;
}

QCheckBox#previewToggle {
    font-weight: 600;
    color: @FG_TEXT@;
}

QLabel#previewHint {
    font-size: 11px;
    color: @FG_MUTED@;
}

QWidget#menuStrip {
    background-color: transparent;
    border: none;
}

QLabel#menuPresetLabel {
    color: @FG_TEXT@;
    font-weight: 600;
    padding-left: 8px;
}

QComboBox#retailPresetCombo {
    min-width: 200px;
}

QWidget#menuStrip QMenuBar {
    background: transparent;
    border: none;
}

QMenuBar {
    background-color: transparent;
    border: none;
    color: @FG_TEXT@;
    min-height: 32px;
}

QMenuBar::item:selected {
    background-color: @BG_HOVER@;
    color: @FG_ACCENT@;
}

QMenu {
    background-color: @BG_PANEL@;
    border: none;
    padding: 4px;
    color: @FG_TEXT@;
}

QMenu::item:selected {
    background-color: @BG_HOVER@;
    color: @FG_ACCENT@;
}

QPushButton {
    background-color: @BG_BUTTON@;
    border: none;
    border-radius: 10px;
    padding: 0 12px;
    min-height: 28px;
    max-height: 28px;
    color: @FG_TEXT@;
    font-weight: 500;
    font-size: 12px;
}

QPushButton:hover {
    background-color: @BG_HOVER@;
    color: @FG_ACCENT@;
}

QPushButton#toolBtn {
    background-color: @BG_BUTTON@;
    border: none;
    padding: 0 6px;
    font-size: 12px;
    min-width: 0;
    border-radius: 10px;
}

QPushButton#toolBtn:hover {
    background-color: @ACCENT@;
    color: #ffffff;
}

QPushButton#btnSecondary {
    background-color: @BG_BUTTON@;
    border: none;
    min-width: 72px;
    border-radius: 10px;
}

QPushButton#btnSecondary:hover {
    background-color: @BG_HOVER@;
    color: @FG_ACCENT@;
}

QPushButton#footerPrimary,
QPushButton#footerSecondary {
    min-height: 32px;
    max-height: 32px;
    min-width: 108px;
    padding: 0 16px;
    font-size: 13px;
    border-radius: 10px;
}

QPushButton#footerPrimary {
    background-color: @ACCENT@;
    color: #ffffff;
    border: none;
    font-weight: 700;
}

QPushButton#footerPrimary:hover {
    background-color: @ACCENT_HOVER@;
}

QPushButton#footerPrimary:disabled {
    background-color: @BG_HOVER@;
    color: @FG_MUTED@;
}

QPushButton#footerSecondary {
    background-color: transparent;
    color: @FG_MUTED@;
    border: none;
    font-weight: 600;
}

QPushButton#footerSecondary:hover {
    background-color: @BG_HOVER@;
    color: @FG_MUTED@;
}

QPushButton#footerConvert {
    min-height: 36px;
    max-height: 36px;
    min-width: 140px;
    padding: 0 18px;
    font-size: 13px;
    border-radius: 10px;
    background-color: @ACCENT@;
    color: #ffffff;
    border: none;
    font-weight: 700;
}

QPushButton#footerConvert:hover {
    background-color: @ACCENT_HOVER@;
}

QPushButton#footerConvert:disabled {
    background-color: @BG_HOVER@;
    color: @FG_MUTED@;
}

QPushButton#footerClose {
    min-height: 36px;
    max-height: 36px;
    min-width: 112px;
    padding: 0 16px;
    font-size: 13px;
    border-radius: 10px;
    background-color: transparent;
    color: @FG_MUTED@;
    border: none;
    font-weight: 600;
}

QPushButton#footerClose:hover {
    background-color: @BG_HOVER@;
    color: @FG_MUTED@;
}

QPushButton#primaryBtn {
    background-color: @ACCENT@;
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 13px;
    min-height: 32px;
    max-height: 32px;
    min-width: 100px;
    border-radius: 10px;
}

QPushButton#primaryBtn:hover {
    background-color: @ACCENT_HOVER@;
}

QPushButton#primaryBtn:disabled {
    background-color: @BG_HOVER@;
    color: @FG_MUTED@;
}

QPushButton#themeToggle {
    background-color: @BG_HOVER@;
    border: none;
    color: @FG_ACCENT@;
    font-weight: 600;
    border-radius: 18px;
    padding: 0 16px;
}

QWidget#themeToggleWidget {
    background: transparent;
    min-width: 72px;
    max-width: 72px;
    min-height: 32px;
    max-height: 32px;
    margin: 4px 12px 0 0;
}

QTreeWidget#inputList {
    background-color: @BG_INPUT@;
    alternate-background-color: @BG_PANEL_ALT@;
    border: none;
    border-radius: 10px;
    color: @FG_TEXT@;
    outline: none;
    padding: 2px;
}

QTreeWidget#inputList QHeaderView::section {
    border-right: 1px solid @SEP@;
}

QTreeWidget#inputList::item {
    padding: 4px 8px;
    min-height: 24px;
    border-bottom: 1px solid @SEP@;
}

QTreeWidget#inputList::item:selected {
    background-color: @ACCENT@;
    color: #ffffff;
}

QTreeWidget#inputList::item:hover:!selected {
    background-color: @BG_HOVER@;
}

QHeaderView::section {
    background-color: @BG_PANEL_ALT@;
    color: @FG_MUTED@;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid @SEP@;
    font-weight: 700;
}

QComboBox {
    background-color: @BG_INPUT@;
    border: none;
    border-radius: 10px;
    padding: 2px 28px 2px 8px;
    min-height: 24px;
    max-height: 30px;
    color: @FG_TEXT@;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
}

QLineEdit, QSpinBox {
    background-color: @BG_INPUT@;
    border: none;
    border-radius: 10px;
    padding: 2px 8px;
    min-height: 28px;
    max-height: 28px;
    color: @FG_TEXT@;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
    qproperty-alignment: 'AlignLeft|AlignVCenter';
}

QLineEdit#outputDirEdit {
    font-size: 10px;
    min-height: 26px;
    max-height: 26px;
}

QComboBox:hover, QLineEdit:hover, QSpinBox:hover {
    background-color: @BG_HOVER@;
}

QComboBox:focus, QLineEdit:focus, QSpinBox:focus {
    border: 1px solid @BORDER_FOCUS@;
    background-color: @BG_INPUT@;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    background: transparent;
}

QComboBox::drop-down:hover {
    background: @BG_PANEL_ALT@;
}

QComboBox::down-arrow {
    image: url(@COMBO_ARROW@);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: @BG_PANEL@;
    color: @FG_TEXT@;
    border: none;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 10px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @ACCENT@;
    color: #ffffff;
}

QListWidget {
    background-color: @BG_INPUT@;
    border: none;
    border-radius: 10px;
    color: @FG_TEXT@;
}

QSlider::groove:horizontal {
    height: 4px;
    background: @BORDER@;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    background: @ACCENT@;
    border: 2px solid @BG_PANEL@;
    border-radius: 6px;
}

QSlider::sub-page:horizontal {
    background: @ACCENT@;
    border-radius: 3px;
}

QProgressBar {
    border: none;
    border-radius: 10px;
    background: @BG_PANEL_ALT@;
    min-height: 12px;
    max-height: 20px;
    color: @FG_MUTED@;
    text-align: center;
}

QProgressBar#mainProgress,
QProgressBar#resultsProgress {
    background: @BG_INPUT@;
}

QLabel#progressStatus {
    color: @FG_TEXT@;
    font-weight: 600;
    background: transparent;
    padding: 2px 0;
}

QFrame#sectionDivider, QFrame#hSeparator {
    background-color: @SEP@;
    color: @SEP@;
    max-height: 1px;
    border: none;
}

QFrame#vSeparator {
    background-color: @SEP@;
    color: @SEP@;
    max-width: 1px;
    min-width: 1px;
    border: none;
}

QProgressBar::chunk {
    background-color: @ACCENT@;
    border-radius: 3px;
}

QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    border-bottom: 2px solid transparent;
    padding: 6px 14px;
    color: @FG_MUTED@;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: @FG_ACCENT@;
    border-bottom: 2px solid @ACCENT@;
}

QCheckBox {
    spacing: 6px;
    color: @FG_TEXT@;
    min-height: 22px;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid @BORDER@;
    background: @BG_INPUT@;
}

QCheckBox::indicator:checked {
    background: @ACCENT@;
    border: 1px solid @ACCENT@;
    image: url(@CHECK_ICON@);
}

QCheckBox::indicator:disabled {
    background: @BG_PANEL_ALT@;
}

QCheckBox:disabled {
    color: @FG_MUTED@;
    background: transparent;
}

QFrame#moreOptions, QGroupBox#moreOptions {
    background-color: @BG_PANEL_ALT@;
    border: none;
    border-radius: 16px;
}

QGroupBox#moreOptions {
    margin-top: 8px;
    padding-top: 8px;
    font-weight: 600;
    color: @FG_TEXT@;
}

QCheckBox#moreToggle {
    font-weight: 600;
    color: @FG_TEXT@;
    padding: 4px 0;
}

QLabel#previewBox {
    border: none;
    border-radius: 10px;
    background-color: @BG_INPUT@;
    min-width: 112px;
    min-height: 112px;
    max-width: 112px;
    max-height: 112px;
}

QStatusBar {
    background: @BG_PANEL@;
    border-top: 1px solid @SEP@;
    color: @FG_MUTED@;
}

QSplitter::handle {
    background: @SEP@;
    width: 1px;
    margin: 6px 3px;
}

QSplitter::handle:hover {
    background: @BORDER@;
}

QDialog#appDialog {
    background-color: @BG_PANEL@;
    color: @FG_TEXT@;
}

QDialog#appDialog QLabel {
    color: @FG_TEXT@;
    background: transparent;
}

QTabWidget#dialogTabs::pane {
    border: none;
    border-radius: 10px;
    background: @BG_PANEL_ALT@;
    padding: 8px;
}

QTabWidget#dialogTabs QTabBar::tab {
    color: @FG_MUTED@;
    padding: 6px 14px;
}

QTabWidget#dialogTabs QTabBar::tab:selected {
    color: @FG_ACCENT@;
    border-bottom: 2px solid @ACCENT@;
}

QTabWidget#dialogTabs QTabBar::tab:last {
    border-left: 1px solid @SEP@;
    margin-left: 8px;
    padding-left: 14px;
}

QAbstractItemView {
    background-color: @BG_INPUT@;
    color: @FG_TEXT@;
    border: none;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
    outline: none;
}

QListView#formatMultiList::item {
    padding: 6px 10px;
    min-height: 24px;
}

QListView#formatMultiList::item:hover:!selected {
    background-color: @BG_HOVER@;
}

QComboBox#formatMultiCombo {
    min-height: 24px;
    max-height: 30px;
    border: none;
}

QComboBox#formatMultiCombo::drop-down {
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox#formatMultiCombo::down-arrow {
    image: url(@COMBO_ARROW@);
    width: 12px;
    height: 12px;
}

QComboBox#formatMultiCombo QLineEdit {
    background: transparent;
    color: @FG_TEXT@;
    border: none;
    padding: 4px 8px;
    qproperty-alignment: 'AlignLeft|AlignVCenter';
}

QComboBox#formatMultiCombo:focus {
    border: 1px solid @BORDER_FOCUS@;
}

QTableWidget#resultsTable {
    background-color: @BG_INPUT@;
    color: @FG_TEXT@;
    border: none;
    gridline-color: @SEP@;
    alternate-background-color: @BG_PANEL_ALT@;
}

QTableWidget#resultsTable::item {
    padding: 5px 8px;
    border-bottom: 1px solid @SEP@;
    border-right: 1px solid @SEP@;
}

QTableWidget#resultsTable::item:selected {
    background-color: @BG_HOVER@;
    color: @FG_TEXT@;
}

QTableWidget#resultsTable QHeaderView::section {
    background-color: @BG_PANEL_ALT@;
    color: @FG_TEXT@;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid @SEP@;
    border-right: 1px solid @SEP@;
    font-weight: 600;
}

QLabel#mattePreview {
    border: none;
    border-radius: 10px;
    background-color: @BG_INPUT@;
}

QPushButton#btnBrowse {
    min-width: 100px;
    padding: 0 12px;
}

QPushButton#btnUpdatePath {
    background-color: @ACCENT@;
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 13px;
    min-height: 32px;
    max-height: 32px;
    min-width: 100px;
    padding: 0 12px;
    border-radius: 10px;
}

QPushButton#btnUpdatePath:hover {
    background-color: @ACCENT_HOVER@;
}

QPushButton#btnUpdatePath:disabled {
    background-color: @BG_PANEL_ALT@;
    color: @FG_MUTED@;
    font-weight: 600;
}

QPushButton#cropAnchorBtn {
    background-color: @BG_INPUT@;
    border: none;
    border-radius: 6px;
    color: @FG_TEXT@;
    padding: 0;
    font-size: 11px;
}

QPushButton#cropAnchorBtn:hover {
    background-color: @BG_HOVER@;
}

QPushButton#cropAnchorBtn:checked {
    background-color: @ACCENT@;
    color: #ffffff;
}

QComboBox:disabled, QLineEdit:disabled, QSpinBox:disabled {
    color: @FG_MUTED@;
    background-color: @BG_PANEL_ALT@;
}

QPushButton:disabled {
    color: @FG_MUTED@;
    background-color: @BG_PANEL_ALT@;
}

QMessageBox {
    background-color: @BG_PANEL@;
    color: @FG_TEXT@;
    border: none;
    border-radius: 16px;
}

QMessageBox QLabel {
    color: @FG_TEXT@;
    background: transparent;
    font-size: 13px;
    min-width: 320px;
    padding: 8px 4px;
}

QMessageBox QPushButton {
    min-width: 88px;
    min-height: 36px;
    max-height: 36px;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 600;
    margin-left: 8px;
    border-radius: 10px;
}

QMessageBox QPushButton#primaryBtn {
    background-color: @ACCENT@;
    color: #ffffff;
    border: none;
}

QMessageBox QPushButton#btnSecondary {
    background-color: @BG_BUTTON@;
    color: @FG_TEXT@;
    border: none;
    min-height: 36px;
    max-height: 36px;
}

/* —— Overlay konwersji —— */
QWidget#conversionOverlay {
    background-color: @OVERLAY_SCRIM@;
}

QFrame#conversionOverlayPanel {
    background-color: @BG_PANEL@;
    border: none;
    border-radius: 16px;
}

QLabel#conversionOverlayTime {
    color: @FG_MUTED@;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#overlayAbortBtn {
    background: transparent;
    color: @OVERLAY_ABORT_COLOR@;
    border: 1px solid @OVERLAY_ABORT_BORDER@;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    padding: 0;
}

QPushButton#overlayAbortBtn:hover {
    background: @OVERLAY_ABORT_HOVER_BG@;
    border-color: @OVERLAY_ABORT_COLOR@;
    color: @OVERLAY_ABORT_COLOR@;
}

QPushButton#overlayAbortBtn:pressed {
    background: @OVERLAY_ABORT_PRESSED@;
}

QLabel#conversionOverlayHint {
    color: @OVERLAY_HINT@;
    font-size: 11px;
    line-height: 1.4;
    padding: 2px 0 4px 0;
    background: transparent;
}

QLabel#conversionOverlayTitle {
    font-size: 15px;
    font-weight: 700;
    color: @FG_TEXT@;
}

QLabel#conversionOverlaySummary {
    color: @FG_MUTED@;
    font-size: 12px;
}

QScrollArea#conversionOverlayScroll {
    background: transparent;
}

QFrame#fileProgressCard {
    background: @BG_PANEL_ALT@;
    border: none;
    border-radius: 10px;
}

QFrame#fileProgressCard[status="active"],
QFrame#fileProgressCard[status="done"],
QFrame#fileProgressCard[status="error"] {
    background: @BG_PANEL_ALT@;
}

QLabel#fileProgressExt {
    background: @BG_INPUT@;
    border: none;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    color: @FG_ACCENT@;
}

QLabel#fileProgressName {
    font-weight: 600;
    color: @FG_TEXT@;
}

QLabel#fileProgressMeta {
    color: @FG_MUTED@;
    font-size: 11px;
}

QLabel#fileProgressPct {
    color: @FG_MUTED@;
    font-size: 11px;
    font-weight: 600;
}

QProgressBar#fileProgressBar,
QProgressBar#conversionOverlayOverall {
    background: @BG_INPUT@;
    border: none;
    border-radius: 10px;
}

QProgressBar#fileProgressBar::chunk,
QProgressBar#conversionOverlayOverall::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @ACCENT@, stop:1 #7c3aed);
    border-radius: 10px;
}

QFrame#updateToast {
    background-color: @UPDATE_TOAST_BG@;
    border: 1px solid @UPDATE_TOAST_BORDER@;
    border-radius: 16px;
    min-width: 280px;
    max-width: 360px;
}

QLabel#updateToastTitle {
    color: @UPDATE_TOAST_TITLE@;
    font-size: 13px;
    font-weight: 600;
}

QLabel#updateToastMessage {
    color: @UPDATE_TOAST_TEXT@;
    font-size: 12px;
}

QLabel#updateToastProgress {
    color: @UPDATE_TOAST_PROGRESS@;
    font-size: 11px;
}

QPushButton#updateToastInstall {
    background-color: @UPDATE_TOAST_INSTALL_BG@;
    color: @UPDATE_TOAST_INSTALL_TEXT@;
    border: none;
    border-radius: 10px;
    padding: 4px 14px;
    font-weight: 600;
}

QPushButton#updateToastInstall:hover {
    background-color: @UPDATE_TOAST_INSTALL_HOVER@;
}

QPushButton#updateToastInstall:disabled {
    background-color: @BG_PANEL_ALT@;
    color: @FG_MUTED@;
}

QPushButton#updateToastLater {
    background-color: @UPDATE_TOAST_LATER_BG@;
    color: @UPDATE_TOAST_LATER_TEXT@;
    border: none;
    border-radius: 10px;
    padding: 4px 14px;
}

QPushButton#updateToastLater:hover {
    background-color: @UPDATE_TOAST_LATER_HOVER@;
}

QLabel#updateDialogStatus {
    color: @FG_TEXT@;
    font-size: 13px;
}

QLabel#updateDialogHint {
    color: @FG_MUTED@;
    font-size: 12px;
}

QProgressBar#updateDialogProgress {
    background: @BG_INPUT@;
    border: none;
    border-radius: 10px;
    min-height: 10px;
}

QProgressBar#updateDialogProgress::chunk {
    background: @UPDATE_TOAST_INSTALL_BG@;
    border-radius: 10px;
}

QFrame#updateStatusBar {
    background-color: @UPDATE_TOAST_BG@;
    border: 1px solid @UPDATE_TOAST_BORDER@;
    border-radius: 10px;
    padding: 2px 6px;
    min-width: 340px;
    max-width: 520px;
}

QLabel#updateStatusSpinner {
    color: @UPDATE_TOAST_INSTALL_BG@;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#updateStatusLabel {
    color: @FG_TEXT@;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

QPushButton#updateStatusCancel {
    background: transparent;
    color: @FG_MUTED@;
    border: none;
    border-radius: 6px;
    font-size: 11px;
    padding: 0;
}

QPushButton#updateStatusCancel:hover {
    color: @OVERLAY_ABORT_COLOR@;
    background: @OVERLAY_ABORT_HOVER_BG@;
}

QPushButton#updateStatusInstall {
    background-color: @UPDATE_TOAST_INSTALL_BG@;
    color: @UPDATE_TOAST_INSTALL_TEXT@;
    border: none;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    padding: 0 10px;
}

QPushButton#updateStatusInstall:hover {
    background-color: @UPDATE_TOAST_INSTALL_HOVER@;
}

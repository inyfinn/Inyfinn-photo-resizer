/* Inyfinn Photo Resizer — styl Dobra Kaloria (design system 1.5.0: skala tekstu i odstępy programu „Stwórz prezentację”) */

QMenu, QToolTip, QMenuBar, QStatusBar, QTabBar::tab, QHeaderView::section {
    font-size: 15px;
}

QToolTip {
    font-size: 14px;
}

QMainWindow {
    background-color: @BG_WINDOW@;
    color: @FG_TEXT@;
    font-family: @FONT_FAMILY@;
    font-size: 15px;
}

QWidget#centralRoot, QWidget#settingsBody, QWidget#simpleView, QWidget#formatSelector, QWidget#leftColumn {
    background-color: transparent;
    color: @FG_TEXT@;
}

QLabel {
    background-color: transparent;
    color: @FG_TEXT@;
}

QLabel#appTitle {
    font-size: 20px;
    font-weight: 700;
    color: @FG_HEADING_ACCENT@;
}

QLabel#versionBadge {
    font-size: 13px;
    font-weight: 700;
    color: @FG_ACCENT@;
    background: transparent;
}

QLabel#panelTitle {
    font-family: @FONT_DISPLAY@;
    font-size: 22px;
    font-weight: 400;
    color: @FG_TITLE@;
    padding: 0;
    margin: 0;
    background: transparent;
}

QLabel#sectionTitle {
    font-family: @FONT_FAMILY@;
    font-size: 14px;
    font-weight: 700;
    color: @FG_HEADING_ACCENT@;
    background: transparent;
}

QLabel#fieldLabel {
    font-size: 14px;
    font-weight: 700;
    color: @FG_TEXT@;
    background: transparent;
    padding: 0;
    margin: 0;
}

QLabel#advancedSummary {
    font-size: 14px;
    color: @FG_MUTED@;
    padding: 0;
    background: transparent;
    border: none;
}

QLabel#appFooter {
    font-size: 13px;
    font-weight: 700;
    color: @FG_MUTED@;
    padding: 0 4px;
    background: transparent;
}

QDialog#helpGuideDialog {
    background-color: @BG_WINDOW@;
    color: @FG_TEXT@;
}

QLabel#helpGuideIntro {
    font-size: 15px;
    color: @FG_TEXT@;
    background: transparent;
}

QLabel#helpGuideItem {
    font-size: 15px;
    line-height: 1.45;
    color: @FG_TEXT@;
    padding: 2px 0;
    background: transparent;
}

QWidget#helpGuideBody {
    background: transparent;
}

/* Sekcja pomocy = sam tekst z ikoną: biała karta wprost na białym oknie → bez wypełnienia, linia 1 px (S13/S14) */
QFrame#helpGuideSection {
    background-color: transparent;
    border: @LINE@;
    border-radius: @RADIUS_CARD@;
}

QLabel#helpGuideBullet {
    font-size: 15px;
    color: @FG_ACCENT@;
    background: transparent;
}

QScrollArea#helpGuideScroll {
    background: transparent;
    border: none;
}

QLabel#helpGuideTitle {
    font-family: @FONT_DISPLAY@;
    font-size: 26px;
    font-weight: 400;
    color: @FG_TITLE@;
}

QLabel#helpGuideVersion {
    font-size: 13px;
    font-weight: 700;
    color: @FG_ACCENT@;
}

QLabel#helpGuideContent {
    font-size: 15px;
    color: @FG_TEXT@;
    padding: 4px 2px;
}

QWidget#fieldGroup {
    background: transparent;
}

QLabel#formLabel, QLabel#formLabelInline {
    color: @FG_LABEL@;
    font-weight: 700;
    background: transparent;
}

QLabel#hintLabel, QLabel#dropHint {
    color: @FG_MUTED@;
    font-size: 14px;
}

QLabel#queueCount {
    font-size: 16px;
    font-weight: 700;
    color: @FG_ACCENT@;
}

QLabel#qualityValue {
    font-weight: 700;
    color: @FG_ACCENT@;
}

QLabel#previewMeta {
    color: @FG_MUTED@;
    font-size: 14px;
}

/* —— Kafelki Bento (wzorzec „Stwórz prezentację”: treść na BIELI, szary panel L1 tylko dla jednego bloku) ——
   Właściwość variant (ustawia kod): panel = szary box L1 (bez właściwości też), plain = bez tła, promienia i obrysu
   (treść na białym oknie), drop = strefa upuszczania: L1 + cienka przerywana ramka field-border. */
QFrame#bentoTile, QFrame#bentoTile[variant="panel"] {
    background-color: @BG_PANEL@;
    border: @CARD_BORDER@;
    border-radius: @RADIUS_CARD@;
}

QFrame#bentoTile[variant="plain"] {
    background-color: transparent;
    border: none;
    border-radius: 0;
}

QFrame#bentoTile[variant="drop"] {
    background-color: @BG_PANEL@;
    border: @DROP_BORDER@;
    border-radius: @RADIUS_DROP@;
}

/* Linia między grupami ustawień na białym (1 px border) */
QFrame#groupSep {
    background-color: @SEP@;
    border: none;
    min-height: 1px;
    max-height: 1px;
    margin: 0;
}

/* Nagłówek kroku w trybie prostym: numer zielony + tytuł, oba Mindset; pusta strefa upuszczania: biała płytka
   z ikoną, tytuł Mindset, podpowiedź */
QLabel#stepNumber {
    font-family: @FONT_DISPLAY@;
    font-size: 26px;
    font-weight: 400;
    color: @FG_HEADING_ACCENT@;
    background: transparent;
    padding: 0;
}

QLabel#dropEmptyIcon {
    background-color: @BG_PANEL_ALT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
}

QLabel#dropEmptyTitle {
    font-family: @FONT_DISPLAY@;
    font-size: 26px;
    font-weight: 400;
    color: @FG_TITLE@;
    background: transparent;
    qproperty-alignment: AlignCenter;
}

QLabel#dropEmptyHint {
    font-size: 15px;
    color: @FG_MUTED@;
    background: transparent;
    qproperty-alignment: AlignCenter;
}

QFrame#panel, QFrame#dropPanel, QFrame#sectionBox, QFrame#previewPanel {
    background-color: @BG_PANEL@;
    border: @CARD_BORDER@;
    border-radius: @RADIUS_CARD@;
}

QLabel#sectionStepTitle {
    font-family: @FONT_DISPLAY@;
    font-size: 26px;
    font-weight: 400;
    color: @FG_TITLE@;
    background: transparent;
    padding: 0;
}

QLabel#sectionStepHint {
    font-size: 14px;
    color: @FG_MUTED@;
    background: transparent;
    padding: 0;
    line-height: 1.35;
}

QSlider {
    min-height: 26px;
    padding: 2px 0;
}

QScrollArea#settingsScroll ,
QScrollArea#simpleScroll {
    background: transparent;
    border: none;
}

QScrollArea#settingsScroll > QWidget > QWidget ,
QScrollArea#simpleScroll > QWidget > QWidget {
    background: transparent;
}

QScrollArea#settingsScroll QScrollBar:vertical ,
QScrollArea#simpleScroll QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 0 4px 2px;
    border: none;
}

QScrollArea#settingsScroll QScrollBar::handle:vertical ,
QScrollArea#simpleScroll QScrollBar::handle:vertical {
    background: @BORDER@;
    border-radius: 5px;
    min-height: 40px;
}

QScrollArea#settingsScroll QScrollBar::handle:vertical:hover ,
QScrollArea#simpleScroll QScrollBar::handle:vertical:hover {
    background: @FIELD_BORDER@;
}

QScrollArea#settingsScroll QScrollBar::add-line:vertical,
QScrollArea#simpleScroll QScrollBar::add-line:vertical,
QScrollArea#settingsScroll QScrollBar::sub-line:vertical ,
QScrollArea#simpleScroll QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QScrollArea#settingsScroll QScrollBar::add-page:vertical,
QScrollArea#simpleScroll QScrollBar::add-page:vertical,
QScrollArea#settingsScroll QScrollBar::sub-page:vertical ,
QScrollArea#simpleScroll QScrollBar::sub-page:vertical {
    background: none;
}

QCheckBox#previewToggle {
    font-weight: 700;
    color: @FG_TEXT@;
}

QLabel#previewHint {
    font-size: 14px;
    color: @FG_MUTED@;
}

QWidget#menuStrip {
    background-color: @MENU_STRIP_BG@;
    border: none;
    border-bottom: @MENU_STRIP_BORDER@;
}

QLabel#menuPresetLabel {
    color: @FG_TEXT@;
    font-weight: 700;
    padding-left: 8px;
}

QComboBox#retailPresetCombo {
    min-width: 200px;
}

QWidget#menuStrip QMenuBar {
    background: transparent;
    border: none;
}

QMenuBar {
    background-color: transparent;
    border: none;
    color: @FG_TEXT@;
    min-height: 40px;
}

QMenuBar::item {
    padding: 8px 14px;
}

QMenuBar::item:selected {
    background-color: @BG_HOVER@;
    color: @FG_TEXT@;
}

/* Nakładki (menu, rozwinięta lista, podpowiedź, toast): rola overlay + ramka 1 px border, nie poziom L4 */
QToolTip {
    background-color: @BG_OVERLAY@;
    color: @FG_TEXT@;
    border: @LINE@;
    border-radius: @RADIUS_BTN@;
    padding: 6px 10px;
}

QMenu {
    background-color: @BG_OVERLAY@;
    border: @LINE@;
    padding: 6px;
    color: @FG_TEXT@;
}

QMenu::item {
    padding: 8px 28px 8px 16px;
}

QMenu::item:selected {
    background-color: @POPUP_SELECTED_BG@;
    color: @ROW_SELECTED_FG@;
}

/* Przyciski (DS 2.0, S6). Drugorzędny (każdy QPushButton bez własnej reguły): tło btn2-bg, tekst btn2-text
   pogrubiony WERSALIKAMI (typography.py; QSS nie ma text-transform), obrys btn2-border, promień 4.
   Grubość obrysu = @BTN2_BORDER_W@, dopełnienie pionowe @BTN2_PAD_V@ = (2 px dawnego obrysu − obrys), więc
   wysokość całkowita bez zmian (QSS min/max-height nie liczy ramki ani dopełnienia); stałe w themes/__init__.py.
   Główny = zielony pełny (primaryBtn, footerPrimary, saveChoicePrimary, updateDialogAction, updateToastInstall,
   updateStatusInstall); żółty CTA wyłącznie footerConvert. Fokus z klawiatury: kolor obrysu (bez zmiany wymiarów). */
QPushButton {
    background-color: @BTN2_BG@;
    border: @BTN2_BORDER_W@ solid @BTN2_BORDER@;
    border-radius: @RADIUS_BTN@;
    padding: @BTN2_PAD_V@ 16px;
    min-height: 32px;
    max-height: 32px;
    color: @BTN2_TEXT@;
    font-weight: 700;
    font-size: @FS_BTN@;
}

QPushButton:hover {
    background-color: @BTN2_HOVER@;
    color: @BTN2_TEXT@;
}

QPushButton:focus {
    border-color: @BORDER_FOCUS@;
}

/* Wersaliki poszerzają napis (+10…30 px), więc poziome dopełnienie małego toolBtn 10 → 6 px: cztery przyciski
   listy plików nadal mieszczą się w jednym rzędzie lewej kolumny */
/* toolBtn i btnUpdatePath to przyciski CICHE (S13, bez obrysu — reguły generowane niżej), więc dopełnienie
   pionowe = @QUIET_PAD_V@ (2 px dawnego obrysu), nie @BTN2_PAD_V@ */
QPushButton#toolBtn {
    padding: @QUIET_PAD_V@ 6px;
    font-size: 14px;
    min-width: 0;
}

/* Tryb prosty: jedna wysokość kontrolek (CONTROL_H = 32 px) */
QPushButton#toolBtn[large="true"] {
    min-height: 36px;
    max-height: 36px;
    padding: @QUIET_PAD_V@ 16px;
    font-size: 15px;
}

QPushButton#btnBrowse[large="true"] {
    min-height: 36px;
    max-height: 36px;
    padding: @BTN2_PAD_V@ 16px;
    font-size: 15px;
}

QPushButton#btnSecondary {
    min-width: 72px;
}

/* Link (S12): tekst text, pogrubiony, podkreślony; najechanie = akcent (zielony) */
QPushButton#btnLink {
    background-color: transparent;
    border: none;
    color: @FG_TEXT@;
    font-weight: 700;
    text-decoration: underline;
    min-width: 72px;
    min-height: 40px;
    max-height: 40px;
    padding: 0 12px;
    border-radius: @RADIUS_BTN@;
}

QPushButton#btnLink:hover {
    background-color: transparent;
    color: @FG_ACCENT@;
}

QPushButton#btnLink:pressed {
    background-color: transparent;
}

QPushButton#btnLink:disabled {
    background-color: transparent;
    color: @FG_MUTED@;
}

QPushButton#footerPrimary,
QPushButton#footerSecondary {
    min-height: 36px;
    max-height: 36px;
    min-width: 108px;
    padding: @BTN2_PAD_V@ 20px;
    font-size: 15px;
    border-radius: @RADIUS_BTN@;
}

QPushButton#footerPrimary {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY_TEXT@;
    border: none;
    padding: 0 20px;
    font-weight: 700;
}

QPushButton#footerPrimary:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#footerPrimary:disabled {
    background-color: @DISABLED_BG@;
    color: @FG_MUTED@;
}

QPushButton#footerSecondary {
    font-weight: 700;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#footerConvert {
    min-height: 48px;
    max-height: 48px;
    min-width: 160px;
    padding: 0 28px;
    font-size: @FS_BTN_PRIMARY@;
    border-radius: @RADIUS_BTN@;
    background-color: @CTA_BG@;
    color: @CTA_TEXT@;
    border: none;
    font-weight: 700;
}

QPushButton#footerConvert:hover {
    background-color: @CTA_HOVER@;
}

QPushButton#footerConvert:disabled {
    background-color: @DISABLED_BG@;
    color: @FG_MUTED@;
}

QLabel#formatChipCaption {
    color: @FG_HEADING_ACCENT@;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

/* Chipy formatu = tagi: odcień stylu z małym przesunięciem barwy na format (design system 1.4.0, „tags”).
   Numer tagu nadaje kod (themes.format_tag): PNG 1, JPG 2, AVIF 3, WebP 4, GIF 5, TIFF 6.
   S13: tag = samo wypełnienie, BEZ obrysu; najechanie / wciśnięcie = mocniejszy odcień (kolor ramki tagu jako
   wypełnienie). Jedyny obrys to fokus z klawiatury (2 px, kolor focus) — wymiary bez zmian: wysokość 48 px bez
   obrysu, przy fokusie 44 + 2×2 px obrysu, dopełnienie poziome −2 px. */
QPushButton#formatChip {
    background-color: @TAG1_BG@;
    border: none;
    color: @TAG1_FG@;
    border-radius: @RADIUS_BTN@;
    min-width: 72px;
    max-width: 96px;
    min-height: @CHIP_H@;
    max-height: @CHIP_H@;
    padding: 0 @CHIP_PAD@;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#formatChip:hover, QPushButton#formatChip:pressed { background-color: @TAG1_BORDER@; }
QPushButton#formatChip[tag="2"] { background-color: @TAG2_BG@; color: @TAG2_FG@; }
QPushButton#formatChip[tag="2"]:hover, QPushButton#formatChip[tag="2"]:pressed { background-color: @TAG2_BORDER@; }
QPushButton#formatChip[tag="3"] { background-color: @TAG3_BG@; color: @TAG3_FG@; }
QPushButton#formatChip[tag="3"]:hover, QPushButton#formatChip[tag="3"]:pressed { background-color: @TAG3_BORDER@; }
QPushButton#formatChip[tag="4"] { background-color: @TAG4_BG@; color: @TAG4_FG@; }
QPushButton#formatChip[tag="4"]:hover, QPushButton#formatChip[tag="4"]:pressed { background-color: @TAG4_BORDER@; }
QPushButton#formatChip[tag="5"] { background-color: @TAG5_BG@; color: @TAG5_FG@; }
QPushButton#formatChip[tag="5"]:hover, QPushButton#formatChip[tag="5"]:pressed { background-color: @TAG5_BORDER@; }
QPushButton#formatChip[tag="6"] { background-color: @TAG6_BG@; color: @TAG6_FG@; }
QPushButton#formatChip[tag="6"]:hover, QPushButton#formatChip[tag="6"]:pressed { background-color: @TAG6_BORDER@; }
QPushButton#formatChip[tag="7"] { background-color: @TAG7_BG@; color: @TAG7_FG@; }
QPushButton#formatChip[tag="7"]:hover, QPushButton#formatChip[tag="7"]:pressed { background-color: @TAG7_BORDER@; }
QPushButton#formatChip[tag="8"] { background-color: @TAG8_BG@; color: @TAG8_FG@; }
QPushButton#formatChip[tag="8"]:hover, QPushButton#formatChip[tag="8"]:pressed { background-color: @TAG8_BORDER@; }

/* Fokus z klawiatury: obrys @FOCUS_W@ w kolorze focus (jedyny obrys chipa); wymiary bez zmian — wysokość i
   dopełnienie pomniejszone o obrys (markery z themes/__init__.py) */
QPushButton#formatChip:focus,
QPushButton#formatChip[tag]:focus {
    border: @FOCUS_W@ solid @BORDER_FOCUS@;
    min-height: @CHIP_FOCUS_H@;
    max-height: @CHIP_FOCUS_H@;
    padding: 0 @CHIP_FOCUS_PAD@;
}

QPushButton#formatChip:disabled {
    background-color: @DISABLED_BG@;
    color: @FG_MUTED@;
}

QLabel#saveChoiceTitle {
    font-family: @FONT_DISPLAY@;
    font-size: 26px;
    font-weight: 400;
    color: @FG_TITLE@;
}

QLabel#saveChoiceBody {
    font-size: 15px;
    color: @FG_TEXT@;
}

QLabel#saveChoiceHint {
    font-size: 14px;
    color: @FG_MUTED@;
}

QPushButton#saveChoicePrimary {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY_TEXT@;
    border: none;
    padding: 0 16px;
    border-radius: @RADIUS_BTN@;
    font-weight: 700;
    font-size: 15px;
}

QPushButton#saveChoicePrimary:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#saveChoiceOutline {
    border-radius: @RADIUS_BTN@;
    font-weight: 700;
    font-size: 15px;
}

QLabel#changelogVersion {
    font-family: @FONT_DISPLAY@;
    font-size: 22px;
    font-weight: 400;
    color: @FG_HEADING_ACCENT@;
}

QPushButton#footerClose {
    min-height: 48px;
    max-height: 48px;
    min-width: 112px;
    padding: 0 12px;
    font-size: 15px;
    border-radius: @RADIUS_BTN@;
    background-color: transparent;
    color: @FG_TEXT@;
    border: none;
    font-weight: 700;
    text-decoration: underline;
}

QPushButton#footerClose:hover {
    background-color: transparent;
    color: @FG_ACCENT@;
}

QPushButton#primaryBtn,
QPushButton#updateDialogAction {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY_TEXT@;
    border: none;
    padding: 0 16px;
    font-weight: 700;
    font-size: 15px;
    min-height: 40px;
    max-height: 40px;
    min-width: 112px;
    border-radius: @RADIUS_BTN@;
}

QPushButton#primaryBtn:hover,
QPushButton#updateDialogAction:hover {
    background-color: @PRIMARY_HOVER@;
}

QPushButton#primaryBtn:disabled,
QPushButton#updateDialogAction:disabled {
    background-color: @DISABLED_BG@;
    color: @FG_MUTED@;
}

QPushButton#themeToggle {
    background-color: @BG_HOVER@;
    border: none;
    color: @FG_ACCENT@;
    font-weight: 700;
    border-radius: 18px;
    padding: 0 16px;
}

QWidget#themeToggleWidget {
    background: transparent;
    min-width: 72px;
    max-width: 72px;
    min-height: 32px;
    max-height: 32px;
    margin: 4px 12px 0 0;
}

/* Lista plików (S10): biała rubryka L2 na szarym panelu, bez obrysu (granicę robi sam kontrast), pasy zebra, bez
   linii pionowych ani poziomych między wierszami */
QTreeWidget#inputList {
    background-color: @BG_PANEL_ALT@;
    alternate-background-color: @BG_ZEBRA@;
    border: none;
    border-radius: @RADIUS_FIELD@;
    color: @FG_TEXT@;
    outline: none;
    padding: 2px;
}

QTreeWidget#inputList QHeaderView::section {
    border-right: none;
}

QTreeWidget#inputList::item {
    padding: 6px 10px;
    min-height: 28px;
    border-bottom: none;
}

/* Kolumna „Rozmiar” ma ✕ po prawej (removable_items.py, strefa 26 px) */
QTreeWidget#inputList::item {
    padding-right: 30px;
}

/* Lista w strefie upuszczania: sama bez tła i obrysu (ramkę i tło robi kafelek variant="drop"); wiersze to białe
   płytki L2 z odstępem 6 px */
QListWidget#simpleFileList {
    background-color: transparent;
    outline: none;
    padding: 4px;
    border: none;
}

QListWidget#simpleFileList::item {
    background-color: @BG_PANEL_ALT@;
    padding: 7px 30px 7px 10px;
    min-height: 26px;
    margin: 3px 0;
    border-radius: @RADIUS_BTN@;
}

/* Wiersze (S3 + „biel ma dominować”): zaznaczony = jasne tło brand-soft + tekst text (pogrubienie robi delegat),
   ikona wiersza zostaje zielona; najechanie = surface-hover (inne niż zaznaczenie) */
QListWidget#simpleFileList::item:selected {
    background-color: @ROW_SELECTED_BG@;
    color: @ROW_SELECTED_FG@;
}

QListWidget#simpleFileList::item:hover:!selected {
    background-color: @ROW_HOVER@;
}

QTreeWidget#inputList::item:selected {
    background-color: @ROW_SELECTED_BG@;
    color: @ROW_SELECTED_FG@;
}

QTreeWidget#inputList::item:hover:!selected {
    background-color: @ROW_HOVER@;
}

/* Nagłówek tabeli (S10): białe tło rubryki, pogrubiony tekst label, tylko dolna linia 1 px */
QHeaderView::section {
    background-color: @BG_PANEL_ALT@;
    color: @FG_LABEL@;
    padding: 10px 12px;
    border: none;
    border-bottom: @LINE@;
    font-weight: 700;
}

QComboBox {
    background-color: @BG_INPUT@;
    border: @FIELD_BORDER_W@ solid @FIELD_BORDER@;
    border-radius: @RADIUS_FIELD@;
    padding: 4px 30px 4px 12px;
    min-height: 30px;
    max-height: 30px;
    color: @FG_TEXT@;
    selection-background-color: @ROW_SELECTED_BG@;
    selection-color: @ROW_SELECTED_FG@;
}

QLineEdit, QSpinBox {
    background-color: @BG_INPUT@;
    border: @FIELD_BORDER_W@ solid @FIELD_BORDER@;
    border-radius: @RADIUS_FIELD@;
    padding: 4px 12px;
    /* 26 + padding 1×2 + ramka 2×2 = 32 px, tyle co przed zmianą stylu */
    min-height: 30px;
    max-height: 30px;
    color: @FG_TEXT@;
    selection-background-color: @ROW_SELECTED_BG@;
    selection-color: @ROW_SELECTED_FG@;
    qproperty-alignment: 'AlignLeft|AlignVCenter';
}

QLineEdit#outputDirEdit {
    font-size: 14px;
    min-height: 30px;
    max-height: 30px;
}

QLineEdit#outputDirEdit[large="true"] {
    font-size: 15px;
    min-height: 30px;
    max-height: 30px;
    padding: 4px 12px;
    border-radius: @RADIUS_FIELD@;
}

QComboBox:hover, QLineEdit:hover, QSpinBox:hover {
    border-color: @FG_MUTED@;
}

/* Fokus (S9): obrys @FOCUS_W@ w kolorze focus; dopełnienie mniejsze o różnicę obrysów (reguły na końcu pliku) */
QComboBox:focus, QLineEdit:focus, QSpinBox:focus {
    border: @FOCUS_W@ solid @BORDER_FOCUS@;
    background-color: @BG_INPUT@;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    border-top-right-radius: @RADIUS_FIELD@;
    border-bottom-right-radius: @RADIUS_FIELD@;
    background: transparent;
}

QComboBox::drop-down:hover {
    background: @BG_HOVER@;
}

QComboBox::down-arrow {
    image: url(@COMBO_ARROW@);
    width: 12px;
    height: 12px;
}

/* Rozwinięta lista = nakładka: overlay + ramka 1 px, zaznaczony wiersz brand-soft + tekst */
QComboBox QAbstractItemView {
    background-color: @BG_OVERLAY@;
    color: @FG_TEXT@;
    border: @LINE@;
    selection-background-color: @POPUP_SELECTED_BG@;
    selection-color: @ROW_SELECTED_FG@;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 6px 12px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @POPUP_SELECTED_BG@;
    color: @ROW_SELECTED_FG@;
}

QListWidget {
    background-color: @BG_PANEL_ALT@;
    border: none;
    border-radius: @RADIUS_FIELD@;
    color: @FG_TEXT@;
}

/* Suwak (G5): tor slider-track, wypełnienie slider-fill, uchwyt jasny z obrysem 2 px slider-thumb-border */
/* Wzorzec: tor 8 px (pełny promień), uchwyt 24 px łącznie (20 + obrys 2×2), margines −8 px centruje go na torze */
QSlider::groove:horizontal {
    height: @SLIDER_TRACK_H@;
    background: @SLIDER_TRACK@;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    width: @SLIDER_THUMB_INNER@;
    height: @SLIDER_THUMB_INNER@;
    margin: @SLIDER_THUMB_MARGIN@ 0;
    background: @SLIDER_THUMB@;
    border: @SLIDER_THUMB_BORDER_W@ solid @SLIDER_THUMB_BORDER@;
    border-radius: 12px;
}

QSlider::sub-page:horizontal {
    background: @SLIDER_FILL@;
    border-radius: 4px;
}

/* Pasek postępu (S8): wypełnienie progress na torze slider-track */
QProgressBar {
    border: none;
    border-radius: 10px;
    background: @SLIDER_TRACK@;
    min-height: 12px;
    max-height: 20px;
    color: @FG_TEXT@;
    text-align: center;
}

QLabel#progressStatus {
    color: @FG_TEXT@;
    font-weight: 700;
    background: transparent;
    padding: 2px 0;
}

QFrame#sectionDivider, QFrame#hSeparator {
    background-color: @SEP@;
    color: @SEP@;
    max-height: 1px;
    border: none;
}

QFrame#vSeparator {
    background-color: @SEP@;
    color: @SEP@;
    max-width: 1px;
    min-width: 1px;
    border: none;
}

QProgressBar::chunk {
    background-color: @PROGRESS@;
    border-radius: 3px;
}

QTabWidget::pane {
    border: none;
    background: transparent;
}

/* Zakładki (S5, S10): nieaktywna tekst text, aktywna zielony tytuł heading-accent z podkreśleniem */
QTabBar::tab {
    background: transparent;
    border-bottom: 3px solid transparent;
    padding: 8px 16px;
    color: @FG_TEXT@;
    font-weight: 700;
}

QTabBar::tab:selected {
    color: @FG_HEADING_ACCENT@;
    border-bottom: 3px solid @FG_HEADING_ACCENT@;
}

QCheckBox, QRadioButton {
    spacing: 10px;
    color: @FG_TEXT@;
    min-height: 28px;
    background: transparent;
}

/* Pole wyboru (G1, S8, DS check-*): wnętrze jasne także po zaznaczeniu, obrys 1,5 px, znak zielony (zaznaczone:
   obrys też w kolorze znaku).
   QSS nie rysuje obrysu 1,5 px (wychodzi 1 albo 2 px), więc cały wskaźnik 20 px to obraz 80×80 na stan
   (icons/generate_check_icons.py), zmniejszany przez Qt; w QSS border: none. */
QCheckBox::indicator, QRadioButton::indicator {
    width: @CHECK_SIZE@;
    height: @CHECK_SIZE@;
    border: none;
    background: transparent;
}

QCheckBox::indicator:unchecked { image: url(@ICON_DIR@/cb-@THEME_KEY@-off.png); }
QCheckBox::indicator:unchecked:hover { image: url(@ICON_DIR@/cb-@THEME_KEY@-off-hover.png); }
QCheckBox::indicator:unchecked:focus { image: url(@ICON_DIR@/cb-@THEME_KEY@-off-focus.png); }
QCheckBox::indicator:checked { image: url(@ICON_DIR@/cb-@THEME_KEY@-on.png); }
QCheckBox::indicator:checked:hover { image: url(@ICON_DIR@/cb-@THEME_KEY@-on-hover.png); }
QCheckBox::indicator:checked:focus { image: url(@ICON_DIR@/cb-@THEME_KEY@-on-focus.png); }
QCheckBox::indicator:unchecked:disabled { image: url(@ICON_DIR@/cb-@THEME_KEY@-off-dis.png); }
QCheckBox::indicator:checked:disabled { image: url(@ICON_DIR@/cb-@THEME_KEY@-on-dis.png); }

QRadioButton::indicator:unchecked { image: url(@ICON_DIR@/rb-@THEME_KEY@-off.png); }
QRadioButton::indicator:unchecked:hover { image: url(@ICON_DIR@/rb-@THEME_KEY@-off-hover.png); }
QRadioButton::indicator:unchecked:focus { image: url(@ICON_DIR@/rb-@THEME_KEY@-off-focus.png); }
QRadioButton::indicator:checked { image: url(@ICON_DIR@/rb-@THEME_KEY@-on.png); }
QRadioButton::indicator:checked:hover { image: url(@ICON_DIR@/rb-@THEME_KEY@-on-hover.png); }
QRadioButton::indicator:checked:focus { image: url(@ICON_DIR@/rb-@THEME_KEY@-on-focus.png); }
QRadioButton::indicator:unchecked:disabled { image: url(@ICON_DIR@/rb-@THEME_KEY@-off-dis.png); }
QRadioButton::indicator:checked:disabled { image: url(@ICON_DIR@/rb-@THEME_KEY@-on-dis.png); }

QCheckBox:disabled, QRadioButton:disabled {
    color: @FG_MUTED@;
    background: transparent;
}

/* Znacznik w menu (Narzędzia → Styl kolorów / Tryb): te same obrazy */
QMenu::indicator {
    width: @CHECK_SIZE@;
    height: @CHECK_SIZE@;
    left: 4px;
}

QMenu::indicator:non-exclusive:unchecked { image: url(@ICON_DIR@/cb-@THEME_KEY@-off.png); }
QMenu::indicator:non-exclusive:checked { image: url(@ICON_DIR@/cb-@THEME_KEY@-on.png); }
QMenu::indicator:exclusive:unchecked { image: url(@ICON_DIR@/rb-@THEME_KEY@-off.png); }
QMenu::indicator:exclusive:checked { image: url(@ICON_DIR@/rb-@THEME_KEY@-on.png); }

QFrame#moreOptions, QGroupBox#moreOptions {
    background-color: @BG_PANEL_ALT@;
    border: none;
    border-radius: @RADIUS_CARD@;
}

QGroupBox#moreOptions {
    margin-top: 8px;
    padding-top: 8px;
    font-weight: 700;
    color: @FG_TEXT@;
}

QCheckBox#moreToggle {
    font-weight: 700;
    color: @FG_TEXT@;
    padding: 4px 0;
}

QLabel#previewBox {
    border: @LINE@;
    border-radius: @RADIUS_FIELD@;
    background-color: @BG_PANEL_ALT@;
    min-width: 112px;
    min-height: 112px;
    max-width: 112px;
    max-height: 112px;
}

QStatusBar {
    background: @BG_WINDOW@;
    border-top: 1px solid @SEP@;
    color: @FG_MUTED@;
}

/* Uchwyt podziału: bez widocznej linii; przy najechaniu cienka linia 2 px pośrodku (margines, bez width —
   szerokość uchwytu ustawia kod okna) */
QSplitter::handle {
    background: transparent;
    margin: 6px 0;
}

QSplitter::handle:hover {
    background: @SEP@;
    margin: 6px 7px;
}

/* Okno dialogowe: tło L0 (biel), zawartość zakładki = panel L1 bez obrysu, pola na nim = L2 (biel) */
QDialog#appDialog {
    background-color: @BG_WINDOW@;
    color: @FG_TEXT@;
}

QDialog#appDialog QLabel {
    background: transparent;
}

QTabWidget#dialogTabs::pane {
    border: none;
    border-radius: @RADIUS_CARD@;
    background: @BG_PANEL@;
    padding: 14px;
}

QTabWidget#dialogTabs QLineEdit:disabled,
QTabWidget#dialogTabs QSpinBox:disabled,
QTabWidget#dialogTabs QDoubleSpinBox:disabled,
QTabWidget#dialogTabs QComboBox:disabled {
    background-color: @DISABLED_BG@;
}

QTabWidget#dialogTabs QTabBar::tab {
    color: @FG_TEXT@;
    padding: 8px 16px;
}

QTabWidget#dialogTabs QTabBar::tab:selected {
    color: @FG_HEADING_ACCENT@;
    border-bottom: 2px solid @FG_HEADING_ACCENT@;
}

QTabWidget#dialogTabs QTabBar::tab:last {
    border-left: 1px solid @SEP@;
    margin-left: 8px;
    padding-left: 14px;
}

QAbstractItemView {
    background-color: @BG_INPUT@;
    color: @FG_TEXT@;
    border: none;
    selection-background-color: @ROW_SELECTED_BG@;
    selection-color: @ROW_SELECTED_FG@;
    outline: none;
}

QListView#formatMultiList::item {
    padding: 6px 12px;
    min-height: 30px;
}

QListView#formatMultiList::item:hover:!selected {
    background-color: @BG_HOVER@;
}

QComboBox#formatMultiCombo {
    min-height: 30px;
    max-height: 30px;
    border: @FIELD_BORDER_W@ solid @FIELD_BORDER@;
}

QComboBox#formatMultiCombo::drop-down {
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox#formatMultiCombo::down-arrow {
    image: url(@COMBO_ARROW@);
    width: 12px;
    height: 12px;
}

QComboBox#formatMultiCombo QLineEdit {
    background: transparent;
    color: @FG_TEXT@;
    border: none;
    padding: 4px 8px;
    qproperty-alignment: 'AlignLeft|AlignVCenter';
}

QComboBox#formatMultiCombo:focus {
    border: @FOCUS_W@ solid @BORDER_FOCUS@;
}

/* Tabela wyników (S10): pasy zebra / biel, bez linii pionowych i poziomych między wierszami */
QTableWidget#resultsTable {
    background-color: @BG_INPUT@;
    color: @FG_TEXT@;
    border: @LINE@;
    gridline-color: transparent;
    alternate-background-color: @BG_ZEBRA@;
}

QTableWidget#resultsTable::item {
    padding: 7px 10px;
    border: none;
}

QTableWidget#resultsTable::item:selected {
    background-color: @ROW_SELECTED_BG@;
    color: @ROW_SELECTED_FG@;
}

QTableWidget#resultsTable QHeaderView::section {
    background-color: @BG_PANEL_ALT@;
    color: @FG_LABEL@;
    padding: 8px 10px;
    border: none;
    border-bottom: @LINE@;
    font-weight: 700;
}

QLabel#mattePreview {
    border: none;
    border-radius: @RADIUS_FIELD@;
    background-color: @BG_PANEL_ALT@;
}

QPushButton#btnBrowse {
    min-width: 100px;
    padding: @BTN2_PAD_V@ 12px;
}

QPushButton#btnUpdatePath {
    font-weight: 700;
    font-size: 15px;
    min-height: 36px;
    max-height: 36px;
    min-width: 100px;
    padding: @QUIET_PAD_V@ 12px;
    border-radius: @RADIUS_BTN@;
}

/* Przycisk cichy (S13): bez obrysu, wypełnienie icon-bg na białym oknie, białe (L2) na panelu / pasku menu,
   najechanie / fokus brand-soft, wciśnięty mocniejszy odcień, wyłączony disabled-bg. Reguły dla panelu mają
   większą specyficzność, więc stany (hover, pressed…) powtarzamy dla każdego przodka — generuje je
   themes.render_qss (znacznik w następnej linii; przyciski toolBtn, btnUpdatePath i właściwość quiet="true"). */
@QUIET_RULES@

/* wyrównanie dopełnienia przycisków z właściwością quiet (reguły id mają wyższą specyficzność niż [quiet]) */
QPushButton[quiet="true"] { padding: @QUIET_PAD_V@ 16px; }
QPushButton#btnBrowse[quiet="true"] { padding: @QUIET_PAD_V@ 12px; }
QPushButton#btnBrowse[large="true"][quiet="true"] { padding: @QUIET_PAD_V@ 16px; }
QPushButton#footerSecondary[quiet="true"] { padding: @QUIET_PAD_V@ 20px; }
QPushButton#btnSecondary[quiet="true"] { padding: @QUIET_PAD_V@ 16px; }

QPushButton#cropAnchorBtn {
    background-color: @BG_INPUT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    color: @FG_TEXT@;
    padding: 0;
    font-size: 13px;
}

QPushButton#cropAnchorBtn:hover {
    background-color: @BG_HOVER@;
}

QPushButton#cropAnchorBtn:checked {
    background-color: @SELECT_BG@;
    color: @SELECT_FG@;
}

/* Pole wyłączone (np. ścieżka, gdy zapis do folderu jest odznaczony): disabled-bg bez obrysu; dopełnienie +1 px
   zastępuje zdjęty obrys, żeby napis się nie ruszył (wysokość jest ustalona) */
QComboBox:disabled {
    color: @FG_MUTED@;
    background-color: @DISABLED_BG@;
    border: none;
    padding: 5px 31px 5px 13px;
}

QLineEdit:disabled, QSpinBox:disabled {
    color: @FG_MUTED@;
    background-color: @DISABLED_BG@;
    border: none;
    padding: 5px 13px;
}

QPushButton:disabled {
    color: @FG_MUTED@;
    background-color: @DISABLED_BG@;
    border-color: @DISABLED_BG@;
}

QMessageBox {
    background-color: @BG_WINDOW@;
    color: @FG_TEXT@;
    border: none;
    border-radius: @RADIUS_CARD@;
}

QMessageBox QLabel {
    color: @FG_TEXT@;
    background: transparent;
    min-width: 320px;
    padding: 8px 4px;
}

QMessageBox QPushButton {
    min-width: 88px;
    min-height: 36px;
    max-height: 36px;
    padding: @BTN2_PAD_V@ 18px;
    margin-left: 8px;
    border-radius: @RADIUS_BTN@;
}

QMessageBox QPushButton#primaryBtn {
    background-color: @PRIMARY_BG@;
    color: @PRIMARY_TEXT@;
    border: none;
    padding: 0 18px;
    min-height: 40px;
    max-height: 40px;
}

QMessageBox QPushButton#btnSecondary {
    min-height: 36px;
    max-height: 36px;
}

/* —— Overlay konwersji —— */
QWidget#conversionOverlay {
    background-color: @OVERLAY_SCRIM@;
}

QFrame#conversionOverlayPanel {
    background-color: @BG_OVERLAY@;
    border: @LINE@;
    border-radius: @RADIUS_CARD@;
}

QLabel#conversionOverlayTime {
    color: @FG_MUTED@;
}

QPushButton#overlayAbortBtn {
    background: @ICON_BG@;
    color: @OVERLAY_ABORT_COLOR@;
    border: none;
    border-radius: @RADIUS_BTN@;
    font-size: 15px;
    font-weight: 700;
    padding: 0;
}

QPushButton#overlayAbortBtn:hover {
    background: @OVERLAY_ABORT_HOVER_BG@;
    color: @OVERLAY_ABORT_COLOR@;
}

QPushButton#overlayAbortBtn:pressed {
    background: @OVERLAY_ABORT_PRESSED@;
}

QLabel#conversionOverlayHint {
    color: @OVERLAY_HINT@;
    padding: 2px 0 4px 0;
    background: transparent;
}

QLabel#conversionOverlayTitle {
    color: @FG_TEXT@;
}

QLabel#conversionOverlaySummary {
    color: @FG_MUTED@;
}

QScrollArea#conversionOverlayScroll {
    background: transparent;
}

/* Cienki pasek przewijania list plików (tryb prosty, zaawansowany) — jak w panelu ustawień */
QListWidget#simpleFileList QScrollBar:vertical,
QTreeWidget#inputList QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 2px;
    border: none;
}

QListWidget#simpleFileList QScrollBar::handle:vertical,
QTreeWidget#inputList QScrollBar::handle:vertical {
    background: @BORDER@;
    border-radius: 5px;
    min-height: 40px;
}

QListWidget#simpleFileList QScrollBar::handle:vertical:hover,
QTreeWidget#inputList QScrollBar::handle:vertical:hover {
    background: @FIELD_BORDER@;
}

QListWidget#simpleFileList QScrollBar::add-line:vertical,
QListWidget#simpleFileList QScrollBar::sub-line:vertical,
QTreeWidget#inputList QScrollBar::add-line:vertical,
QTreeWidget#inputList QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QListWidget#simpleFileList QScrollBar::add-page:vertical,
QListWidget#simpleFileList QScrollBar::sub-page:vertical,
QTreeWidget#inputList QScrollBar::add-page:vertical,
QTreeWidget#inputList QScrollBar::sub-page:vertical {
    background: none;
}

/* Cienki pasek przewijania listy plików — jak w panelu ustawień (settingsScroll) */
QScrollArea#conversionOverlayScroll QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 0 4px 2px;
    border: none;
}

QScrollArea#conversionOverlayScroll QScrollBar::handle:vertical {
    background: @BORDER@;
    border-radius: 5px;
    min-height: 40px;
}

QScrollArea#conversionOverlayScroll QScrollBar::handle:vertical:hover {
    background: @FIELD_BORDER@;
}

QScrollArea#conversionOverlayScroll QScrollBar::add-line:vertical,
QScrollArea#conversionOverlayScroll QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QScrollArea#conversionOverlayScroll QScrollBar::add-page:vertical,
QScrollArea#conversionOverlayScroll QScrollBar::sub-page:vertical {
    background: none;
}

/* Viewport i kontener listy — bez tego przezroczyste tło malowało czarne pasy między kartami */
QScrollArea#conversionOverlayScroll > QWidget,
QScrollArea#conversionOverlayScroll > QWidget > QWidget {
    background: @BG_OVERLAY@;
}

/* Karta pliku w oknie konwersji leży na overlay (biel) → poziom L1 (panel) */
QFrame#fileProgressCard {
    background: @BG_PANEL@;
    border: none;
    border-radius: @RADIUS_FIELD@;
}

QFrame#fileProgressCard[status="active"],
QFrame#fileProgressCard[status="done"],
QFrame#fileProgressCard[status="error"] {
    background: @BG_PANEL@;
}

/* Znacznik rozszerzenia w oknie konwersji = tag (ten sam kolor formatu co chip w trybie prostym) */
QLabel#fileProgressExt {
    background-color: @TAG8_BG@;
    border: none;
    border-radius: 6px;
    color: @TAG8_FG@;
    padding: 1px 9px;
}

QLabel#fileProgressExt[tag="1"] { background-color: @TAG1_BG@; color: @TAG1_FG@; }
QLabel#fileProgressExt[tag="2"] { background-color: @TAG2_BG@; color: @TAG2_FG@; }
QLabel#fileProgressExt[tag="3"] { background-color: @TAG3_BG@; color: @TAG3_FG@; }
QLabel#fileProgressExt[tag="4"] { background-color: @TAG4_BG@; color: @TAG4_FG@; }
QLabel#fileProgressExt[tag="5"] { background-color: @TAG5_BG@; color: @TAG5_FG@; }
QLabel#fileProgressExt[tag="6"] { background-color: @TAG6_BG@; color: @TAG6_FG@; }
QLabel#fileProgressExt[tag="7"] { background-color: @TAG7_BG@; color: @TAG7_FG@; }

QLabel#fileProgressName {
    color: @FG_TEXT@;
}

QLabel#fileProgressMeta {
    color: @FG_MUTED@;
}

QLabel#fileProgressPct {
    color: @FG_MUTED@;
}

QProgressBar#fileProgressBar,
QProgressBar#conversionOverlayOverall {
    background: @SLIDER_TRACK@;
    border: none;
    border-radius: 4px;
}

QProgressBar#fileProgressBar::chunk,
QProgressBar#conversionOverlayOverall::chunk {
    background: @PROGRESS@;
    border-radius: 10px;
}

QFrame#updateToast {
    background-color: @UPDATE_TOAST_BG@;
    border: 1px solid @UPDATE_TOAST_BORDER@;
    border-radius: @RADIUS_CARD@;
    min-width: 280px;
    max-width: 360px;
}

QLabel#updateToastTitle {
    font-family: @FONT_DISPLAY@;
    color: @UPDATE_TOAST_TITLE@;
    font-size: 15px;
    font-weight: 400;
}

QLabel#updateToastMessage {
    color: @UPDATE_TOAST_TEXT@;
    font-size: 14px;
}

QLabel#updateToastProgress {
    color: @UPDATE_TOAST_PROGRESS@;
    font-size: 13px;
}

QPushButton#updateToastInstall {
    background-color: @UPDATE_TOAST_INSTALL_BG@;
    color: @UPDATE_TOAST_INSTALL_TEXT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    padding: 8px 18px;
    font-weight: 700;
}

QPushButton#updateToastInstall:hover {
    background-color: @UPDATE_TOAST_INSTALL_HOVER@;
}

QPushButton#updateToastInstall:disabled {
    background-color: @BG_PANEL_ALT@;
    color: @FG_MUTED@;
}

/* „Później” = link (design system: anulowanie i powrót to link-przycisk) */
QPushButton#updateToastLater {
    background-color: transparent;
    color: @FG_TEXT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    padding: 8px 18px;
    font-weight: 700;
    text-decoration: underline;
}

QPushButton#updateToastLater:hover {
    background-color: transparent;
    color: @FG_ACCENT@;
}

QLabel#updateDialogStatus {
    color: @FG_TEXT@;
    font-size: 15px;
}

QLabel#updateDialogHint {
    color: @FG_MUTED@;
    font-size: 14px;
}

QProgressBar#updateDialogProgress {
    background: @SLIDER_TRACK@;
    border: none;
    border-radius: 10px;
    min-height: 10px;
}

QProgressBar#updateDialogProgress::chunk {
    background: @PROGRESS@;
    border-radius: 10px;
}

QFrame#updateStatusBar {
    background-color: @UPDATE_TOAST_BG@;
    border: 1px solid @UPDATE_TOAST_BORDER@;
    border-radius: @RADIUS_FIELD@;
    padding: 2px 6px;
    min-width: 340px;
    max-width: 520px;
}

QLabel#updateStatusSpinner {
    color: @UPDATE_TOAST_INSTALL_BG@;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

QLabel#updateStatusLabel {
    color: @FG_TEXT@;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
}

QPushButton#updateStatusCancel {
    background: transparent;
    color: @FG_MUTED@;
    border: none;
    border-radius: @RADIUS_BTN@;
    font-size: 13px;
    padding: 0;
}

QPushButton#updateStatusCancel:hover {
    color: @OVERLAY_ABORT_COLOR@;
    background: @OVERLAY_ABORT_HOVER_BG@;
}

QPushButton#updateStatusInstall {
    background-color: @UPDATE_TOAST_INSTALL_BG@;
    color: @UPDATE_TOAST_INSTALL_TEXT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    font-size: 13px;
    font-weight: 700;
    padding: 0 10px;
}

QPushButton#updateStatusInstall:hover {
    background-color: @UPDATE_TOAST_INSTALL_HOVER@;
}

/* —— Styl Dobra Kaloria: stany, których nie było wcześniej —— */
QLabel#appTitleLabel {
    font-family: @FONT_DISPLAY@;
    font-size: 20px;
    font-weight: 400;
    color: @FG_HEADING_ACCENT@;
    padding-left: 8px;
}

QPushButton:pressed {
    background-color: @BTN2_PRESSED@;
}

QPushButton#footerConvert:pressed {
    background-color: @CTA_HOVER@;
}

QPushButton#footerPrimary:pressed,
QPushButton#primaryBtn:pressed,
QPushButton#updateDialogAction:pressed,
QPushButton#saveChoicePrimary:pressed,
QPushButton#updateToastInstall:pressed,
QPushButton#updateStatusInstall:pressed {
    background-color: @PRIMARY_HOVER@;
}

/* Przycisk-ikona (S7): kwadrat ustawia kod (setFixedSize), tu tylko wygląd: tło icon-bg, bez obrysu, promień 4 */
QPushButton#iconBtn {
    background-color: @ICON_BG@;
    border: none;
    border-radius: @RADIUS_BTN@;
    padding: 0;
    min-width: 0;
    min-height: 0;
    max-height: 16777215px;
}

QPushButton#iconBtn:hover {
    background-color: @BG_HOVER@;
}

QPushButton#iconBtn:pressed {
    background-color: @BTN2_PRESSED@;
}

QPushButton#iconBtn:disabled {
    background-color: @DISABLED_BG@;
    border: none;
}

/* Panel w oknie dialogowym (L1, bez obrysu, promień 8), karta w panelu (L2 biała); karta wprost na białym
   tle dostaje linię 1 px przez właściwość onWhite=true. Pola w panelu = L2 + 1 px field-border (reguły ogólne). */
QFrame#dialogPanel {
    background-color: @BG_PANEL@;
    border: none;
    border-radius: @RADIUS_CARD@;
}

QFrame#dialogCard {
    background-color: @BG_PANEL_ALT@;
    border: none;
    border-radius: @RADIUS_CARD@;
}

QFrame#dialogCard[onWhite="true"] {
    border: @LINE@;
}

QFrame#dialogPanel QLabel, QFrame#dialogCard QLabel {
    background: transparent;
}

QPushButton#footerClose:disabled {
    background-color: transparent;
    color: @FG_MUTED@;
}

QPushButton#formatChip:disabled {
    background-color: @DISABLED_BG@;
    color: @FG_MUTED@;
}

/* Fokus pola (S15): obrys @FOCUS_W@ w kolorze focus = ta sama grubość co obrys pola (@FIELD_BORDER_W@), więc ramka
   i wypełnienie się nie zmieniają — żadnego kompensowania dopełnienia (test_theme_roles pilnuje, że obie grubości
   z DS są równe i że reguły fokusu pola nie ruszają dopełnienia). */


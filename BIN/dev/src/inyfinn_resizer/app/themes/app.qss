/* Inyfinn Photo Resizer — styl Dobra Kaloria (design system 1.5.0: skala tekstu i odstępy programu „Stwórz prezentację”) */

QMenu, QToolTip, QMenuBar, QStatusBar, QTabBar::tab, QHeaderView::section {
    font-size: 15px;
}

QToolTip {
    font-size: 14px;
}

QMainWindow {
    background-color: @BG_WINDOW@;
    color: @FG_TEXT@;
    font-family: @FONT_FAMILY@;
    font-size: 15px;
}

QWidget#centralRoot, QWidget#settingsBody, QWidget#simpleView, QWidget#formatSelector, QWidget#leftColumn {
    background-color: transparent;
    color: @FG_TEXT@;
}

QLabel {
    background-color: transparent;
    color: @FG_TEXT@;
}

QLabel#appTitle {
    font-size: 20px;
    font-weight: 700;
    color: @FG_TITLE@;
}

QLabel#versionBadge {
    font-size: 13px;
    font-weight: 700;
    color: @FG_ACCENT@;
    background: transparent;
}

QLabel#panelTitle {
    font-family: @FONT_DISPLAY@;
    font-size: 22px;
    font-weight: 400;
    color: @FG_TITLE@;
    padding: 0;
    margin: 0;
    background: transparent;
}

QLabel#sectionTitle {
    font-family: @FONT_FAMILY@;
    font-size: 14px;
    font-weight: 700;
    color: @FG_LABEL@;
    background: transparent;
}

QLabel#fieldLabel {
    font-size: 14px;
    font-weight: 700;
    color: @FG_TEXT@;
    background: transparent;
    padding: 0;
    margin: 0;
}

QLabel#advancedSummary {
    font-size: 14px;
    color: @FG_MUTED@;
    padding: 0;
    background: transparent;
    border: none;
}

QLabel#appFooter {
    font-size: 13px;
    font-weight: 700;
    color: @FG_MUTED@;
    padding: 0 4px;
    background: transparent;
}

QDialog#helpGuideDialog {
    background-color: @BG_WINDOW@;
    color: @FG_TEXT@;
}

QLabel#helpGuideIntro {
    font-size: 15px;
    color: @FG_TEXT@;
    background: transparent;
}

QLabel#helpGuideItem {
    font-size: 15px;
    line-height: 1.45;
    color: @FG_TEXT@;
    padding: 2px 0;
    background: transparent;
}

QWidget#helpGuideBody {
    background: transparent;
}

QFrame#helpGuideSection {
    background-color: @BG_PANEL@;
    border: @CARD_BORDER@;
    border-radius: @RADIUS_CARD@;
}

QLabel#helpGuideBullet {
    font-size: 15px;
    color: @FG_ACCENT@;
    background: transparent;
}

QScrollArea#helpGuideScroll {
    background: transparent;
    border: none;
}

QLabel#helpGuideTitle {
    font-family: @FONT_DISPLAY@;
    font-size: 26px;
    font-weight: 400;
    color: @FG_TITLE@;
}

QLabel#helpGuideVersion {
    font-size: 13px;
    font-weight: 700;
    color: @FG_ACCENT@;
}

QLabel#helpGuideContent {
    font-size: 15px;
    color: @FG_TEXT@;
    padding: 4px 2px;
}

QWidget#fieldGroup {
    background: transparent;
}

QLabel#formLabel, QLabel#formLabelInline {
    color: @FG_MUTED@;
    font-weight: 700;
    background: transparent;
}

QLabel#hintLabel, QLabel#dropHint {
    color: @FG_MUTED@;
    font-size: 14px;
}

QLabel#queueCount {
    font-size: 16px;
    font-weight: 700;
    color: @FG_ACCENT@;
}

QLabel#qualityValue {
    font-weight: 700;
    color: @FG_ACCENT@;
}

QLabel#previewMeta {
    color: @FG_MUTED@;
    font-size: 14px;
}

/* —— Kafelki Bento —— */
QFrame#bentoTile {
    background-color: @BG_PANEL@;
    border: @CARD_BORDER@;
    border-radius: @RADIUS_CARD@;
}

QFrame#panel, QFrame#dropPanel, QFrame#sectionBox, QFrame#previewPanel {
    background-color: @BG_PANEL@;
    border: @CARD_BORDER@;
    border-radius: @RADIUS_CARD@;
}

QLabel#sectionStepTitle {
    font-family: @FONT_DISPLAY@;
    font-size: 22px;
    font-weight: 400;
    color: @FG_TITLE@;
    background: transparent;
    padding: 0;
}

QLabel#sectionStepHint {
    font-size: 14px;
    color: @FG_MUTED@;
    background: transparent;
    padding: 0;
    line-height: 1.35;
}

QLabel#workflowHint {
    font-size: 14px;
    color: @FG_MUTED@;
    background: transparent;
    padding: 0 2px 4px 2px;
}

QSlider {
    min-height: 26px;
    padding: 2px 0;
}

QScrollArea#settingsScroll ,
QScrollArea#simpleScroll {
    background: transparent;
    border: none;
}

QScrollArea#settingsScroll > QWidget > QWidget ,
QScrollArea#simpleScroll > QWidget > QWidget {
    background: transparent;
}

QScrollArea#settingsScroll QScrollBar:vertical ,
QScrollArea#simpleScroll QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 0 4px 2px;
    border: none;
}

QScrollArea#settingsScroll QScrollBar::handle:vertical ,
QScrollArea#simpleScroll QScrollBar::handle:vertical {
    background: @BORDER@;
    border-radius: 5px;
    min-height: 40px;
}

QScrollArea#settingsScroll QScrollBar::handle:vertical:hover ,
QScrollArea#simpleScroll QScrollBar::handle:vertical:hover {
    background: @FG_MUTED@;
}

QScrollArea#settingsScroll QScrollBar::add-line:vertical,
QScrollArea#simpleScroll QScrollBar::add-line:vertical,
QScrollArea#settingsScroll QScrollBar::sub-line:vertical ,
QScrollArea#simpleScroll QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QScrollArea#settingsScroll QScrollBar::add-page:vertical,
QScrollArea#simpleScroll QScrollBar::add-page:vertical,
QScrollArea#settingsScroll QScrollBar::sub-page:vertical ,
QScrollArea#simpleScroll QScrollBar::sub-page:vertical {
    background: none;
}

QCheckBox#previewToggle {
    font-weight: 700;
    color: @FG_TEXT@;
}

QLabel#previewHint {
    font-size: 14px;
    color: @FG_MUTED@;
}

QWidget#menuStrip {
    background-color: @MENU_STRIP_BG@;
    border: none;
    border-bottom: @MENU_STRIP_BORDER@;
}

QLabel#menuPresetLabel {
    color: @FG_TEXT@;
    font-weight: 700;
    padding-left: 8px;
}

QComboBox#retailPresetCombo {
    min-width: 200px;
}

QWidget#menuStrip QMenuBar {
    background: transparent;
    border: none;
}

QMenuBar {
    background-color: transparent;
    border: none;
    color: @FG_TEXT@;
    min-height: 40px;
}

QMenuBar::item {
    padding: 8px 14px;
}

QMenuBar::item:selected {
    background-color: @BG_HOVER@;
    color: @FG_ACCENT@;
}

/* L4 — nakładki: menu, rozwinięta lista, podpowiedź */
QToolTip {
    background-color: @BG_L4@;
    color: @FG_TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 4px;
    padding: 6px 10px;
}

QMenu {
    background-color: @BG_L4@;
    border: 1px solid @SEP@;
    padding: 6px;
    color: @FG_TEXT@;
}

QMenu::item {
    padding: 8px 28px 8px 16px;
}

QMenu::item:selected {
    background-color: @BG_HOVER@;
    color: @FG_ACCENT@;
}

QPushButton {
    background-color: transparent;
    border: 2px solid @ACCENT@;
    border-radius: @RADIUS_BTN@;
    padding: 0 16px;
    /* 24 + ramka 2×2 = 28 px, tyle co przed zmianą stylu */
    min-height: 32px;
    max-height: 32px;
    color: @FG_ACCENT@;
    font-weight: 700;
    font-size: 15px;
}

QPushButton:hover {
    background-color: @BRAND_SOFT@;
    color: @FG_ACCENT@;
}

QPushButton#toolBtn {
    background-color: transparent;
    border: 2px solid @ACCENT@;
    padding: 0 10px;
    font-size: 14px;
    min-width: 0;
    border-radius: @RADIUS_BTN@;
}

/* Tryb prosty: jedna wysokość kontrolek (CONTROL_H = 32 px) */
QPushButton#toolBtn[large="true"] {
    /* CONTROL_H = 32: 28 + ramka 2×2 */
    min-height: 36px;
    max-height: 36px;
    padding: 0 16px;
    font-size: 15px;
}

QPushButton#btnBrowse[large="true"] {
    min-height: 36px;
    max-height: 36px;
    padding: 0 16px;
    font-size: 15px;
    border-radius: @RADIUS_BTN@;
}

QPushButton#toolBtn:hover {
    background-color: @BRAND_SOFT@;
    color: @FG_ACCENT@;
}

QPushButton#btnSecondary {
    background-color: transparent;
    border: 2px solid @ACCENT@;
    min-width: 72px;
    border-radius: @RADIUS_BTN@;
}

QPushButton#btnSecondary:hover {
    background-color: @BRAND_SOFT@;
    color: @FG_ACCENT@;
}

QPushButton#btnLink {
    background-color: transparent;
    border: none;
    color: @FG_ACCENT@;
    font-weight: 700;
    text-decoration: underline;
    min-width: 72px;
    min-height: 40px;
    max-height: 40px;
    padding: 0 12px;
    border-radius: @RADIUS_BTN@;
}

QPushButton#btnLink:hover {
    background-color: transparent;
    color: @ACCENT_HOVER@;
}

QPushButton#btnLink:pressed {
    background-color: transparent;
}

QPushButton#btnLink:disabled {
    background-color: transparent;
    color: @FG_MUTED@;
}

QPushButton#footerPrimary,
QPushButton#footerSecondary {
    min-height: 36px;
    max-height: 36px;
    min-width: 108px;
    padding: 0 20px;
    font-size: 15px;
    border-radius: @RADIUS_BTN@;
}

QPushButton#footerPrimary {
    background-color: @CTA_BG@;
    color: @CTA_TEXT@;
    border: none;
    font-weight: 700;
}

QPushButton#footerPrimary:hover {
    background-color: @CTA_HOVER@;
}

QPushButton#footerPrimary:disabled {
    background-color: @BG_HOVER@;
    color: @FG_MUTED@;
}

QPushButton#footerSecondary {
    background-color: transparent;
    color: @FG_ACCENT@;
    border: 2px solid @ACCENT@;
    font-weight: 700;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#footerSecondary:hover {
    background-color: @BRAND_SOFT@;
    color: @FG_ACCENT@;
}

QPushButton#footerConvert {
    min-height: 48px;
    max-height: 48px;
    min-width: 160px;
    padding: 0 28px;
    font-size: 17px;
    border-radius: @RADIUS_BTN@;
    background-color: @CTA_BG@;
    color: @CTA_TEXT@;
    border: none;
    font-weight: 700;
}

QPushButton#footerConvert:hover {
    background-color: @CTA_HOVER@;
}

QPushButton#footerConvert:disabled {
    background-color: @BG_HOVER@;
    color: @FG_MUTED@;
}

QLabel#formatChipCaption {
    color: @FG_LABEL@;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

/* Chipy formatu = tagi: odcień stylu z małym przesunięciem barwy na format (design system 1.4.0, „tags”).
   Numer tagu nadaje kod (themes.format_tag): PNG 1, JPG 2, AVIF 3, WebP 4, GIF 5, TIFF 6.
   To przyciski, więc ramka 2 px w kolorze tekstu tagu (ramka tagu z DS jest za słaba na element klikalny);
   najechanie = tło w kolorze ramki tagu (odcień ciemniej w jasnym, jaśniej w ciemnym). */
QPushButton#formatChip {
    background-color: @TAG1_BG@;
    border: 1px solid @TAG1_FG@;
    color: @TAG1_FG@;
    border-radius: @RADIUS_BTN@;
    min-width: 72px;
    max-width: 96px;
    /* 46 + ramka 1×2 = 48 px, tyle co Konwertuj (bez ramki) */
    min-height: 46px;
    max-height: 46px;
    padding: 0 12px;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#formatChip:hover, QPushButton#formatChip:pressed { background-color: @TAG1_BORDER@; }
QPushButton#formatChip[tag="2"] { background-color: @TAG2_BG@; border-color: @TAG2_FG@; color: @TAG2_FG@; }
QPushButton#formatChip[tag="2"]:hover, QPushButton#formatChip[tag="2"]:pressed { background-color: @TAG2_BORDER@; }
QPushButton#formatChip[tag="3"] { background-color: @TAG3_BG@; border-color: @TAG3_FG@; color: @TAG3_FG@; }
QPushButton#formatChip[tag="3"]:hover, QPushButton#formatChip[tag="3"]:pressed { background-color: @TAG3_BORDER@; }
QPushButton#formatChip[tag="4"] { background-color: @TAG4_BG@; border-color: @TAG4_FG@; color: @TAG4_FG@; }
QPushButton#formatChip[tag="4"]:hover, QPushButton#formatChip[tag="4"]:pressed { background-color: @TAG4_BORDER@; }
QPushButton#formatChip[tag="5"] { background-color: @TAG5_BG@; border-color: @TAG5_FG@; color: @TAG5_FG@; }
QPushButton#formatChip[tag="5"]:hover, QPushButton#formatChip[tag="5"]:pressed { background-color: @TAG5_BORDER@; }
QPushButton#formatChip[tag="6"] { background-color: @TAG6_BG@; border-color: @TAG6_FG@; color: @TAG6_FG@; }
QPushButton#formatChip[tag="6"]:hover, QPushButton#formatChip[tag="6"]:pressed { background-color: @TAG6_BORDER@; }
QPushButton#formatChip[tag="7"] { background-color: @TAG7_BG@; border-color: @TAG7_FG@; color: @TAG7_FG@; }
QPushButton#formatChip[tag="7"]:hover, QPushButton#formatChip[tag="7"]:pressed { background-color: @TAG7_BORDER@; }
QPushButton#formatChip[tag="8"] { background-color: @TAG8_BG@; border-color: @TAG8_FG@; color: @TAG8_FG@; }
QPushButton#formatChip[tag="8"]:hover, QPushButton#formatChip[tag="8"]:pressed { background-color: @TAG8_BORDER@; }

/* Fokus z klawiatury: ramka w kolorze akcentu */
QPushButton#formatChip:focus {
    border-color: @BORDER_FOCUS@;
}

QPushButton#formatChip:disabled {
    border-color: @SEP@;
    color: @FG_MUTED@;
}

QLabel#saveChoiceTitle {
    font-family: @FONT_DISPLAY@;
    font-size: 26px;
    font-weight: 400;
    color: @FG_TITLE@;
}

QLabel#saveChoiceBody {
    font-size: 15px;
    color: @FG_TEXT@;
}

QLabel#saveChoiceHint {
    font-size: 14px;
    color: @FG_MUTED@;
}

QPushButton#saveChoicePrimary {
    background-color: @CTA_BG@;
    color: @CTA_TEXT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    font-weight: 700;
    font-size: 15px;
}

QPushButton#saveChoicePrimary:hover {
    background-color: @CTA_HOVER@;
}

QPushButton#saveChoiceOutline {
    background: transparent;
    color: @FG_ACCENT@;
    border: 2px solid @ACCENT@;
    border-radius: @RADIUS_BTN@;
    font-weight: 700;
    font-size: 15px;
}

QPushButton#saveChoiceOutline:hover {
    background-color: @BRAND_SOFT@;
    color: @FG_ACCENT@;
}

QLabel#changelogVersion {
    font-family: @FONT_DISPLAY@;
    font-size: 22px;
    font-weight: 400;
    color: @FG_ACCENT@;
}

QPushButton#footerClose {
    min-height: 48px;
    max-height: 48px;
    min-width: 112px;
    padding: 0 12px;
    font-size: 15px;
    border-radius: @RADIUS_BTN@;
    background-color: transparent;
    color: @FG_ACCENT@;
    border: none;
    font-weight: 700;
    text-decoration: underline;
}

QPushButton#footerClose:hover {
    background-color: transparent;
    color: @ACCENT_HOVER@;
}

QPushButton#primaryBtn,
QPushButton#updateDialogAction {
    background-color: @CTA_BG@;
    color: @CTA_TEXT@;
    border: none;
    font-weight: 700;
    font-size: 15px;
    min-height: 40px;
    max-height: 40px;
    min-width: 112px;
    border-radius: @RADIUS_BTN@;
}

QPushButton#primaryBtn:hover,
QPushButton#updateDialogAction:hover {
    background-color: @CTA_HOVER@;
}

QPushButton#primaryBtn:disabled,
QPushButton#updateDialogAction:disabled {
    background-color: @BG_HOVER@;
    color: @FG_MUTED@;
}

QPushButton#themeToggle {
    background-color: @BG_HOVER@;
    border: none;
    color: @FG_ACCENT@;
    font-weight: 700;
    border-radius: 18px;
    padding: 0 16px;
}

QWidget#themeToggleWidget {
    background: transparent;
    min-width: 72px;
    max-width: 72px;
    min-height: 32px;
    max-height: 32px;
    margin: 4px 12px 0 0;
}

QTreeWidget#inputList {
    background-color: @BG_PANEL_ALT@;
    /* L2 rubryka, co drugi wiersz L3 */
    alternate-background-color: @BG_L3@;
    border: 1px solid @SEP@;
    border-radius: @RADIUS_FIELD@;
    color: @FG_TEXT@;
    outline: none;
    padding: 2px;
}

QTreeWidget#inputList QHeaderView::section {
    border-right: 1px solid @SEP@;
}

QTreeWidget#inputList::item {
    padding: 6px 10px;
    min-height: 28px;
    border-bottom: 1px solid @SEP@;
}

/* Kolumna „Rozmiar” ma ✕ po prawej (removable_items.py, strefa 26 px) */
QTreeWidget#inputList::item {
    padding-right: 30px;
}

QListWidget#simpleFileList {
    outline: none;
    padding: 4px;
    /* Dobra Kaloria: strefa upuszczania z przerywaną ramką, jak w programie do prezentacji */
    border: @DROP_BORDER@;
    border-radius: @RADIUS_DROP@;
}

QListWidget#simpleFileList::item {
    padding: 7px 30px 7px 10px;
    min-height: 26px;
    border-radius: 6px;
}

QListWidget#simpleFileList::item:selected {
    background-color: @ACCENT@;
    color: @ON_ACCENT@;
}

/* Najechanie na wiersz w rubryce (L2) = poziom głębiej niż wiersze (L3 w liście, L4 w drzewie z L3 co drugi) */
QListWidget#simpleFileList::item:hover:!selected {
    background-color: @BG_L3@;
}

QTreeWidget#inputList::item:selected {
    background-color: @ACCENT@;
    color: @ON_ACCENT@;
}

QTreeWidget#inputList::item:hover:!selected {
    background-color: @BG_L4@;
}

QHeaderView::section {
    background-color: @BG_PANEL_ALT@;
    color: @FG_MUTED@;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid @SEP@;
    font-weight: 700;
}

QComboBox {
    background-color: @BG_INPUT@;
    border: 1px solid @FIELD_BORDER@;
    border-radius: @RADIUS_FIELD@;
    padding: 4px 30px 4px 12px;
    min-height: 30px;
    max-height: 30px;
    color: @FG_TEXT@;
    selection-background-color: @ACCENT@;
    selection-color: @ON_ACCENT@;
}

QLineEdit, QSpinBox {
    background-color: @BG_INPUT@;
    border: 1px solid @FIELD_BORDER@;
    border-radius: @RADIUS_FIELD@;
    padding: 4px 12px;
    /* 26 + padding 1×2 + ramka 2×2 = 32 px, tyle co przed zmianą stylu */
    min-height: 30px;
    max-height: 30px;
    color: @FG_TEXT@;
    selection-background-color: @ACCENT@;
    selection-color: @ON_ACCENT@;
    qproperty-alignment: 'AlignLeft|AlignVCenter';
}

QLineEdit#outputDirEdit {
    font-size: 14px;
    min-height: 30px;
    max-height: 30px;
}

QLineEdit#outputDirEdit[large="true"] {
    font-size: 15px;
    min-height: 30px;
    max-height: 30px;
    padding: 4px 12px;
    border-radius: @RADIUS_FIELD@;
}

QComboBox:hover, QLineEdit:hover, QSpinBox:hover {
    border-color: @FG_MUTED@;
}

QComboBox:focus, QLineEdit:focus, QSpinBox:focus {
    border: 2px solid @BORDER_FOCUS@;
    background-color: @BG_INPUT@;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    border-top-right-radius: @RADIUS_FIELD@;
    border-bottom-right-radius: @RADIUS_FIELD@;
    background: transparent;
}

QComboBox::drop-down:hover {
    background: @BG_L3@;
}

QComboBox::down-arrow {
    image: url(@COMBO_ARROW@);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: @BG_L4@;
    color: @FG_TEXT@;
    border: none;
    selection-background-color: @ACCENT@;
    selection-color: @ON_ACCENT@;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 6px 12px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @ACCENT@;
    color: @ON_ACCENT@;
}

QListWidget {
    background-color: @BG_PANEL_ALT@;
    border: none;
    border-radius: @RADIUS_FIELD@;
    color: @FG_TEXT@;
}

QSlider::groove:horizontal {
    height: 6px;
    background: @BORDER@;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -8px 0;
    background: @ACCENT@;
    border: 2px solid @BG_PANEL@;
    border-radius: 11px;
}

QSlider::sub-page:horizontal {
    background: @ACCENT@;
    border-radius: 3px;
}

QProgressBar {
    border: none;
    border-radius: 10px;
    background: @BG_PANEL_ALT@;
    min-height: 12px;
    max-height: 20px;
    color: @FG_MUTED@;
    text-align: center;
}

QProgressBar#mainProgress,
QProgressBar#resultsProgress {
    background: @BG_INPUT@;
}

QLabel#progressStatus {
    color: @FG_TEXT@;
    font-weight: 700;
    background: transparent;
    padding: 2px 0;
}

QFrame#sectionDivider, QFrame#hSeparator {
    background-color: @SEP@;
    color: @SEP@;
    max-height: 1px;
    border: none;
}

QFrame#vSeparator {
    background-color: @SEP@;
    color: @SEP@;
    max-width: 1px;
    min-width: 1px;
    border: none;
}

QProgressBar::chunk {
    background-color: @ACCENT@;
    border-radius: 3px;
}

QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    border-bottom: 3px solid transparent;
    padding: 8px 16px;
    color: @FG_MUTED@;
    font-weight: 700;
}

QTabBar::tab:selected {
    color: @FG_ACCENT@;
    border-bottom: 3px solid @ACCENT@;
}

QCheckBox {
    spacing: 10px;
    color: @FG_TEXT@;
    min-height: 28px;
    background: transparent;
}

QCheckBox::indicator {
    /* 16 + ramka 2×2 = 20 px */
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid @FIELD_BORDER@;
    background: @BG_INPUT@;
}

QCheckBox::indicator:checked {
    background: @ACCENT@;
    border: 2px solid @ACCENT@;
    image: url(@CHECK_ICON@);
}

QCheckBox::indicator:disabled {
    background: @BG_PANEL_ALT@;
}

QCheckBox:disabled {
    color: @FG_MUTED@;
    background: transparent;
}

QFrame#moreOptions, QGroupBox#moreOptions {
    background-color: @BG_PANEL_ALT@;
    border: none;
    border-radius: @RADIUS_CARD@;
}

QGroupBox#moreOptions {
    margin-top: 8px;
    padding-top: 8px;
    font-weight: 700;
    color: @FG_TEXT@;
}

QCheckBox#moreToggle {
    font-weight: 700;
    color: @FG_TEXT@;
    padding: 4px 0;
}

QLabel#previewBox {
    border: none;
    border-radius: @RADIUS_FIELD@;
    background-color: @BG_PANEL_ALT@;
    min-width: 112px;
    min-height: 112px;
    max-width: 112px;
    max-height: 112px;
}

QStatusBar {
    background: @BG_WINDOW@;
    border-top: 1px solid @SEP@;
    color: @FG_MUTED@;
}

QSplitter::handle {
    background: @SEP@;
    width: 1px;
    margin: 6px 3px;
}

QSplitter::handle:hover {
    background: @BORDER@;
}

QDialog#appDialog {
    background-color: @BG_PANEL@;
    color: @FG_TEXT@;
}

QDialog#appDialog QLabel {
    color: @FG_TEXT@;
    background: transparent;
}

QTabWidget#dialogTabs::pane {
    border: none;
    border-radius: @RADIUS_FIELD@;
    background: @BG_PANEL_ALT@;
    padding: 14px;
}

/* Rubryki na zakładce (zakładka = L2) są o poziom głębiej: L3 */
QTabWidget#dialogTabs QLineEdit,
QTabWidget#dialogTabs QSpinBox,
QTabWidget#dialogTabs QDoubleSpinBox,
QTabWidget#dialogTabs QComboBox,
QTabWidget#dialogTabs QCheckBox::indicator:unchecked {
    background-color: @BG_L3@;
}

QTabWidget#dialogTabs QLineEdit:disabled,
QTabWidget#dialogTabs QSpinBox:disabled,
QTabWidget#dialogTabs QDoubleSpinBox:disabled,
QTabWidget#dialogTabs QComboBox:disabled {
    background-color: @DISABLED_BG@;
}

QTabWidget#dialogTabs QTabBar::tab {
    color: @FG_MUTED@;
    padding: 8px 16px;
}

QTabWidget#dialogTabs QTabBar::tab:selected {
    color: @FG_ACCENT@;
    border-bottom: 2px solid @ACCENT@;
}

QTabWidget#dialogTabs QTabBar::tab:last {
    border-left: 1px solid @SEP@;
    margin-left: 8px;
    padding-left: 14px;
}

QAbstractItemView {
    background-color: @BG_INPUT@;
    color: @FG_TEXT@;
    border: none;
    selection-background-color: @ACCENT@;
    selection-color: @ON_ACCENT@;
    outline: none;
}

QListView#formatMultiList::item {
    padding: 6px 12px;
    min-height: 30px;
}

QListView#formatMultiList::item:hover:!selected {
    background-color: @BG_HOVER@;
}

QComboBox#formatMultiCombo {
    min-height: 30px;
    max-height: 30px;
    border: 1px solid @FIELD_BORDER@;
}

QComboBox#formatMultiCombo::drop-down {
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox#formatMultiCombo::down-arrow {
    image: url(@COMBO_ARROW@);
    width: 12px;
    height: 12px;
}

QComboBox#formatMultiCombo QLineEdit {
    background: transparent;
    color: @FG_TEXT@;
    border: none;
    padding: 4px 8px;
    qproperty-alignment: 'AlignLeft|AlignVCenter';
}

QComboBox#formatMultiCombo:focus {
    border: 2px solid @BORDER_FOCUS@;
}

QTableWidget#resultsTable {
    background-color: @BG_INPUT@;
    color: @FG_TEXT@;
    border: none;
    gridline-color: @SEP@;
    alternate-background-color: @BG_L3@;
}

QTableWidget#resultsTable::item {
    padding: 7px 10px;
    border-bottom: 1px solid @SEP@;
    border-right: 1px solid @SEP@;
}

QTableWidget#resultsTable::item:selected {
    background-color: @BG_L4@;
    color: @FG_TEXT@;
}

QTableWidget#resultsTable QHeaderView::section {
    background-color: @BG_PANEL_ALT@;
    color: @FG_TEXT@;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid @SEP@;
    border-right: 1px solid @SEP@;
    font-weight: 700;
}

QLabel#mattePreview {
    border: none;
    border-radius: @RADIUS_FIELD@;
    background-color: @BG_PANEL_ALT@;
}

QPushButton#btnBrowse {
    min-width: 100px;
    padding: 0 12px;
}

QPushButton#btnUpdatePath {
    background-color: transparent;
    color: @FG_ACCENT@;
    border: 2px solid @ACCENT@;
    font-weight: 700;
    font-size: 15px;
    min-height: 36px;
    max-height: 36px;
    min-width: 100px;
    padding: 0 12px;
    border-radius: @RADIUS_BTN@;
}

QPushButton#btnUpdatePath:hover {
    background-color: @BRAND_SOFT@;
}

QPushButton#btnUpdatePath:disabled {
    background-color: @DISABLED_BG@;
    border-color: @DISABLED_BG@;
    color: @FG_MUTED@;
    font-weight: 700;
}

QPushButton#cropAnchorBtn {
    background-color: @BG_INPUT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    color: @FG_TEXT@;
    padding: 0;
    font-size: 13px;
}

QPushButton#cropAnchorBtn:hover {
    background-color: @BG_HOVER@;
}

QPushButton#cropAnchorBtn:checked {
    background-color: @ACCENT@;
    color: @ON_ACCENT@;
}

QComboBox:disabled, QLineEdit:disabled, QSpinBox:disabled {
    color: @FG_MUTED@;
    background-color: @DISABLED_BG@;
    border-color: @SEP@;
}

QPushButton:disabled {
    color: @FG_MUTED@;
    background-color: @DISABLED_BG@;
    border-color: @DISABLED_BG@;
}

QMessageBox {
    background-color: @BG_PANEL@;
    color: @FG_TEXT@;
    border: none;
    border-radius: @RADIUS_CARD@;
}

QMessageBox QLabel {
    color: @FG_TEXT@;
    background: transparent;
    min-width: 320px;
    padding: 8px 4px;
}

QMessageBox QPushButton {
    min-width: 88px;
    /* 32 + ramka 2×2 = 36 px */
    min-height: 36px;
    max-height: 36px;
    padding: 0 18px;
    margin-left: 8px;
    border-radius: @RADIUS_BTN@;
}

QMessageBox QPushButton#primaryBtn {
    background-color: @CTA_BG@;
    color: @CTA_TEXT@;
    border: none;
    min-height: 40px;
    max-height: 40px;
}

QMessageBox QPushButton#btnSecondary {
    background-color: transparent;
    color: @FG_ACCENT@;
    border: 2px solid @ACCENT@;
    min-height: 36px;
    max-height: 36px;
}

/* —— Overlay konwersji —— */
QWidget#conversionOverlay {
    background-color: @OVERLAY_SCRIM@;
}

QFrame#conversionOverlayPanel {
    background-color: @BG_PANEL@;
    border: @CARD_BORDER@;
    border-radius: @RADIUS_CARD@;
}

QLabel#conversionOverlayTime {
    color: @FG_MUTED@;
}

QPushButton#overlayAbortBtn {
    background: transparent;
    color: @OVERLAY_ABORT_COLOR@;
    border: 1px solid @OVERLAY_ABORT_BORDER@;
    border-radius: @RADIUS_BTN@;
    font-size: 15px;
    font-weight: 700;
    padding: 0;
}

QPushButton#overlayAbortBtn:hover {
    background: @OVERLAY_ABORT_HOVER_BG@;
    border-color: @OVERLAY_ABORT_COLOR@;
    color: @OVERLAY_ABORT_COLOR@;
}

QPushButton#overlayAbortBtn:pressed {
    background: @OVERLAY_ABORT_PRESSED@;
}

QLabel#conversionOverlayHint {
    color: @OVERLAY_HINT@;
    padding: 2px 0 4px 0;
    background: transparent;
}

QLabel#conversionOverlayTitle {
    color: @FG_TEXT@;
}

QLabel#conversionOverlaySummary {
    color: @FG_MUTED@;
}

QScrollArea#conversionOverlayScroll {
    background: transparent;
}

/* Viewport i kontener listy — bez tego przezroczyste tło malowało czarne pasy między kartami */
QScrollArea#conversionOverlayScroll > QWidget,
QScrollArea#conversionOverlayScroll > QWidget > QWidget {
    background: @BG_PANEL@;
}

QFrame#fileProgressCard {
    background: @BG_PANEL_ALT@;
    border: none;
    border-radius: @RADIUS_FIELD@;
}

QFrame#fileProgressCard[status="active"],
QFrame#fileProgressCard[status="done"],
QFrame#fileProgressCard[status="error"] {
    background: @BG_PANEL_ALT@;
}

/* Znacznik rozszerzenia w oknie konwersji = tag (ten sam kolor formatu co chip w trybie prostym) */
QLabel#fileProgressExt {
    background-color: @TAG8_BG@;
    border: 1px solid @TAG8_BORDER@;
    border-radius: 6px;
    color: @TAG8_FG@;
    padding: 0 8px;
}

QLabel#fileProgressExt[tag="1"] { background-color: @TAG1_BG@; border-color: @TAG1_BORDER@; color: @TAG1_FG@; }
QLabel#fileProgressExt[tag="2"] { background-color: @TAG2_BG@; border-color: @TAG2_BORDER@; color: @TAG2_FG@; }
QLabel#fileProgressExt[tag="3"] { background-color: @TAG3_BG@; border-color: @TAG3_BORDER@; color: @TAG3_FG@; }
QLabel#fileProgressExt[tag="4"] { background-color: @TAG4_BG@; border-color: @TAG4_BORDER@; color: @TAG4_FG@; }
QLabel#fileProgressExt[tag="5"] { background-color: @TAG5_BG@; border-color: @TAG5_BORDER@; color: @TAG5_FG@; }
QLabel#fileProgressExt[tag="6"] { background-color: @TAG6_BG@; border-color: @TAG6_BORDER@; color: @TAG6_FG@; }
QLabel#fileProgressExt[tag="7"] { background-color: @TAG7_BG@; border-color: @TAG7_BORDER@; color: @TAG7_FG@; }

QLabel#fileProgressName {
    color: @FG_TEXT@;
}

QLabel#fileProgressMeta {
    color: @FG_MUTED@;
}

QLabel#fileProgressPct {
    color: @FG_MUTED@;
}

QProgressBar#fileProgressBar,
QProgressBar#conversionOverlayOverall {
    background: @BORDER@;
    border: none;
    border-radius: 4px;
}

QProgressBar#fileProgressBar::chunk,
QProgressBar#conversionOverlayOverall::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @ACCENT@, stop:1 @ACCENT_GRAD_END@);
    border-radius: 10px;
}

QFrame#updateToast {
    background-color: @UPDATE_TOAST_BG@;
    border: 1px solid @UPDATE_TOAST_BORDER@;
    border-radius: @RADIUS_CARD@;
    min-width: 280px;
    max-width: 360px;
}

QLabel#updateToastTitle {
    color: @UPDATE_TOAST_TITLE@;
    font-size: 15px;
    font-weight: 700;
}

QLabel#updateToastMessage {
    color: @UPDATE_TOAST_TEXT@;
    font-size: 14px;
}

QLabel#updateToastProgress {
    color: @UPDATE_TOAST_PROGRESS@;
    font-size: 13px;
}

QPushButton#updateToastInstall {
    background-color: @UPDATE_TOAST_INSTALL_BG@;
    color: @UPDATE_TOAST_INSTALL_TEXT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    padding: 8px 18px;
    font-weight: 700;
}

QPushButton#updateToastInstall:hover {
    background-color: @UPDATE_TOAST_INSTALL_HOVER@;
}

QPushButton#updateToastInstall:disabled {
    background-color: @BG_PANEL_ALT@;
    color: @FG_MUTED@;
}

/* „Później” = link (design system: anulowanie i powrót to link-przycisk) */
QPushButton#updateToastLater {
    background-color: transparent;
    color: @FG_ACCENT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    padding: 8px 18px;
    font-weight: 700;
    text-decoration: underline;
}

QPushButton#updateToastLater:hover {
    background-color: transparent;
    color: @ACCENT_HOVER@;
}

QLabel#updateDialogStatus {
    color: @FG_TEXT@;
    font-size: 15px;
}

QLabel#updateDialogHint {
    color: @FG_MUTED@;
    font-size: 14px;
}

QProgressBar#updateDialogProgress {
    background: @BG_INPUT@;
    border: none;
    border-radius: 10px;
    min-height: 10px;
}

QProgressBar#updateDialogProgress::chunk {
    background: @UPDATE_TOAST_INSTALL_BG@;
    border-radius: 10px;
}

QFrame#updateStatusBar {
    background-color: @UPDATE_TOAST_BG@;
    border: 1px solid @UPDATE_TOAST_BORDER@;
    border-radius: @RADIUS_FIELD@;
    padding: 2px 6px;
    min-width: 340px;
    max-width: 520px;
}

QLabel#updateStatusSpinner {
    color: @UPDATE_TOAST_INSTALL_BG@;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

QLabel#updateStatusLabel {
    color: @FG_TEXT@;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
}

QPushButton#updateStatusCancel {
    background: transparent;
    color: @FG_MUTED@;
    border: none;
    border-radius: @RADIUS_BTN@;
    font-size: 13px;
    padding: 0;
}

QPushButton#updateStatusCancel:hover {
    color: @OVERLAY_ABORT_COLOR@;
    background: @OVERLAY_ABORT_HOVER_BG@;
}

QPushButton#updateStatusInstall {
    background-color: @UPDATE_TOAST_INSTALL_BG@;
    color: @UPDATE_TOAST_INSTALL_TEXT@;
    border: none;
    border-radius: @RADIUS_BTN@;
    font-size: 13px;
    font-weight: 700;
    padding: 0 10px;
}

QPushButton#updateStatusInstall:hover {
    background-color: @UPDATE_TOAST_INSTALL_HOVER@;
}

/* —— Styl Dobra Kaloria: stany, których nie było wcześniej —— */
QLabel#appTitleLabel {
    font-family: @FONT_DISPLAY@;
    font-size: 20px;
    font-weight: 400;
    color: @FG_TITLE@;
    padding-left: 8px;
}

QPushButton:pressed {
    background-color: @BG_HOVER@;
}

QPushButton#footerConvert:pressed,
QPushButton#footerPrimary:pressed,
QPushButton#primaryBtn:pressed,
QPushButton#updateDialogAction:pressed,
QPushButton#saveChoicePrimary:pressed {
    background-color: @CTA_HOVER@;
}

QPushButton#footerClose:disabled {
    background-color: transparent;
    color: @FG_MUTED@;
}

QPushButton#formatChip:disabled {
    background-color: @DISABLED_BG@;
    border-color: @DISABLED_BG@;
    color: @FG_MUTED@;
}

/* Fokus 3 px bez przesuwania tekstu: ramka +1, wypełnienie −1 */
QComboBox:focus {
    padding: 3px 29px 3px 11px;
}

QLineEdit:focus, QSpinBox:focus {
    padding: 3px 11px;
}

QLineEdit#outputDirEdit[large="true"]:focus {
    padding: 3px 11px;
}

QCheckBox::indicator:hover {
    border-color: @ACCENT@;
}

QCheckBox::indicator:checked:disabled, QCheckBox::indicator:disabled {
    border-color: @SEP@;
}
